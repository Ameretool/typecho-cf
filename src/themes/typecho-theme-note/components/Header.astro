<header id="header" class="clearfix">
    <div class="container">
        <!-- Logo 和 简介 -->
        <div class="site-header">
            <h1 id="logo">
                <a href="/"><img src="/logo.png" alt="HB" /></a> 
                <!-- 如果你没有图片Logo，用下面这行代替上面那行 -->
                <!-- <a href="/">HB</a> -->
            </h1>
            <p class="description">一个基于 Typecho CF 构建、运行在 Cloudflare 上的微型博客，记录技术踩坑、图床搭建与日常随笔，追求极简、高速。</p>
        </div>

        <!-- 电脑端主题切换按钮（按原代码靠右对齐） -->
        <div class="desktop-theme-switcher">
            <button class="theme-opt active" data-mode="light">☀️</button>
            <button class="theme-opt" data-mode="dark">🌙</button>
            <button class="theme-opt" data-mode="system">💻</button>
        </div>

        <!-- 搜索框 -->
        <div id="search" class="site-search">
            <form method="post" action="/search">
                <input type="text" name="keywords" class="text" placeholder="输入关键字搜索" />
                <button type="submit">搜索</button>
            </form>
        </div>

        <!-- 导航菜单 -->
        <nav id="nav-menu" class="clearfix">
            <a href="/" class="current">首页</a>
            <a href="/bookmarks">书签</a>
            <a href="/about">关于</a>
        </nav>

        <!-- 移动端主题切换按钮 -->
        <div class="mobile-theme-switcher">
            <button class="mobile-theme-toggle">◐</button>
            <div class="mobile-theme-menu">
                <button class="theme-opt-mobile" data-mode="light">浅色模式</button>
                <button class="theme-opt-mobile" data-mode="dark">深色模式</button>
                <button class="theme-opt-mobile" data-mode="system">跟随系统</button>
            </div>
        </div>
    </div>
</header>
