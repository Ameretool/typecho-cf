---
/**
 * 微型博客 / 碎碎念 动态页 (纯净版)
 */
import Base from '@/layouts/Base.astro';
import Header from '@/themes/typecho-theme-note/components/Header.astro'; // 请核对你的 Header 实际路径
import type { ThemeIndexProps } from '@/lib/theme-props';
import { formatDate } from '@/lib/content';

type Props = ThemeIndexProps;

const {
  options, urls, user, isLoggedIn, pages, currentPath, pluginCtx, posts, pagination
} = Astro.props;

// 过滤：只保留分类或标签包含“碎碎念”的文章
const microPosts = posts.filter(post => {
  const hasCategory = post.categories?.some(c => c.name === '碎碎念');
  const hasTag = post.tags?.some(t => t.name === '碎碎念' || t.name === '微博');
  return hasCategory || hasTag;
});
---

<Base title={`动态 - ${options.title}`} options={options} urls={urls} user={user} isLoggedIn={isLoggedIn} pluginCtx={pluginCtx}>
  <Header options={options} urls={urls} pages={pages} currentPath={currentPath} />

  <div id="body">
    <div class="container" style="max-width: 640px; margin: 40px auto; padding: 0 20px;">
      
      <!-- 顶部引导语 -->
      <div style="text-align: center; margin-bottom: 40px; opacity: 0.6; font-size: 14px; letter-spacing: 1px;">
        · 记录瞬间的碎碎念 ·
      </div>

      {microPosts.length === 0 ? (
        <p style="text-align: center; opacity: 0.5; margin-top: 50px;">当前页没有动态哦~</p>
      ) : (
        <div class="micro-timeline">
          {microPosts.map((post) => (
            <div class="micro-item" style="position: relative; margin-bottom: 40px; padding-bottom: 24px; border-bottom: 1px dashed var(--border-color);">
              
              <!-- 头部：头像 + 作者 + 时间 -->
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <div style="font-size: 13px; color: #8a8f9a; display: flex; align-items: center; gap: 8px;">
                  <img src={post.author?.avatarUrl || '/img/avatar.svg'} alt="avatar" style="width: 20px; height: 20px; border-radius: 50%; opacity: 0.8;" />
                  <span>{post.author?.screenName || post.author?.name || 'HB'}</span>
                </div>
                <time datetime={new Date((post.created) * 1000).toISOString()} style="font-size: 12px; color: #8a8f9a;">
                  {formatDate(post.created, 'Y.m.d H:i', options.timezone)}
                </time>
              </div>

              <!-- 正文内容 (自动继承主题的排版) -->
              <div class="post-content" set:html={post.content} style="font-size: 15px; line-height: 1.8; color: var(--text-color); word-break: break-word;">
              </div>

              <!-- 底部互动（只有评论跳转） -->
              <div style="margin-top: 16px; font-size: 13px; text-align: right;">
                <a href={`${post.permalink}#comments`} style="color: var(--accent-color); text-decoration: none; border: none; background: transparent;">
                  💬 {post.commentsNum === 0 ? '去评论' : `${post.commentsNum} 条评论`}
                </a>
              </div>
            </div>
          ))}
        </div>
      )}

      <!-- 翻页导航（如果碎碎念极多，可以用这个翻页） -->
      {pagination.totalPages > 1 && (
        <nav class="page-navigator" style="margin-top: 30px; text-align: center;">
          {pagination.hasPrev && <a class="prev" href={pagination.prevUrl!} style="margin-right: 15px;">&laquo; 前一页</a>}
          {pagination.hasNext && <a class="next" href={pagination.nextUrl!}>后一页 &raquo;</a>}
        </nav>
      )}

    </div>
  </div>
</Base>
