---
type Props = {
  options: any;
  urls: any;
};
const { options, urls } = Astro.props;
---

<footer id="footer" role="contentinfo">
  &copy; {new Date().getFullYear()} <a href="{urls.siteUrl}">{options.title}</a>. 由 <a href="#">Typecho CloudFlare</a> 强力驱动.
  <span id="page-speed" style="margin-left: 8px; font-size: 0.85em; opacity: 0.6;"></span>
</footer>

<style is:global>
  /* 👇 1. 给页脚顶部加一条跟随主题颜色的边框线，并收紧间距 👇 */
  #footer {
    border-top: 1px solid var(--border-color);
    margin-top: 15px; /* 从 50px 缩减到 15px，紧贴分页 */
    padding: 25px 0 35px; /* 调整上下内边距，不至于太挤 */
    text-align: center;
    color: var(--text-color);
    opacity: 0.8;
  }
  
  #footer a {
    color: var(--accent-color);
    text-decoration: none;
  }

  /* 👇 2. 顺手修复侧边栏长文本撑爆屏幕的 Bug 👇 */
  #secondary, 
  .widget, 
  .widget-list li, 
  .widget-list a {
    word-wrap: break-word !important;
    word-break: break-all !important;
    overflow-wrap: break-word !important;
  }
</style>

<script is:inline>
  window.addEventListener('load', () => {
    setTimeout(() => {
      // 获取浏览器的性能导航数据
      const nav = performance.getEntriesByType('navigation')[0];
      const el = document.getElementById('page-speed');
      
      if (nav && el) {
        // 计算 TTFB（首字节时间，即服务器响应时间）
        const start = nav.startTime || nav.fetchStart;
        const ttfb = Math.round(nav.responseStart - start);
        
        // 格式化时间：大于等于1000ms就转成秒（保留两位小数），小于1000ms直接显示ms
        let displayTime = '';
        if (ttfb >= 1000) {
          displayTime = (ttfb / 1000).toFixed(2) + ' s';
        } else {
          displayTime = ttfb + ' ms';
        }
        
        // 显示在页脚
        el.textContent = `| 响应 ${displayTime}`;
      }
    }, 0);
  });
</script>
