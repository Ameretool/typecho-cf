---
type Props = {
  options: any;
  urls: any;
};
const { options, urls } = Astro.props;
---
<footer id="footer" role="contentinfo">
  &copy; {new Date().getFullYear()} <a href="{urls.siteUrl}">{options.title}</a>. 由 <a href="#">Typecho CloudFlare</a> 强力驱动.
  <span id="page-speed" style="margin-left: 8px; font-size: 0.85em; opacity: 0.6;"></span>
</footer>

<style is:global>
  /* 👇 1. 彻底干掉分页组件底部自带的 margin 👇 */
  .super-pagination, .page-navigator {
    margin-bottom: 0 !important; 
    padding-bottom: 0 !important;
  }

  /* 👇 2. 干掉所有外层容器和主内容区的底部空白 👇 */
  #body, #main, .container, .row {
    padding-bottom: 0 !important;
    margin-bottom: 0 !important;
  }

  /* 👇 3. 页脚顶线及间距 👇 */
  #footer {
    border-top: 1px solid var(--border-color) !important;
    margin-top: 15px !important; /* 这 15px 是唯一留下的呼吸空间 */
    padding: 15px 0 25px !important; 
    text-align: center;
    color: var(--text-color);
    opacity: 0.8;
  }
  
  #footer a {
    color: var(--accent-color);
    text-decoration: none;
  }
</style>

<script is:inline>
  window.addEventListener('load', () => {
    setTimeout(() => {
      const nav = performance.getEntriesByType('navigation')[0];
      const el = document.getElementById('page-speed');
      
      if (nav && el) {
        const start = nav.startTime || nav.fetchStart;
        const ttfb = Math.round(nav.responseStart - start);
        
        let displayTime = '';
        if (ttfb >= 1000) {
          displayTime = (ttfb / 1000).toFixed(2) + ' s';
        } else {
          displayTime = ttfb + ' ms';
        }
        
        el.textContent = `| 响应 ${displayTime}`;
      }
    }, 0);
  });
</script>
