---
/**
 * Default theme — Index (home page) component
 *
 * Renders the blog post list with pagination.
 * Equivalent to the original index.astro template section.
 */
import Base from '@/layouts/Base.astro';
import type { ThemeIndexProps } from '@/lib/theme-props';
import { formatDate, buildAuthorLink, buildCategoryLink } from '@/lib/content';
// ⚠️ 唯一新增：导入截取100字函数
import { renderContentExcerpt } from '@/lib/markdown';

type Props = ThemeIndexProps;

const {
  options, urls, user, isLoggedIn, pages, sidebarData, currentPath, pluginCtx,
  posts, pagination,
} = Astro.props;

const isIndex = currentPath === '/';
---
<Base options={options} urls={urls} user={user} isLoggedIn={isLoggedIn} pluginCtx={pluginCtx}>
  <header id="header" class="clearfix">
    <div class="container">
      <div class="row">
        <div class="site-name col-mb-12 col-9">
          <a id="logo" href={urls.siteUrl + '/'}>{options.title}</a>
          <p class="description">{options.description}</p>
        </div>
        
        <!-- 🌟 增加了一点点样式，让设置面板相对这个区域绝对定位 -->
        <div class="site-search col-3 kit-hidden-tb" style="position: relative;">
          <form id="search" method="post" action={urls.siteUrl + '/'} role="search">
            <label for="s" class="sr-only">搜索关键字</label>
            <input type="text" id="s" name="s" class="text" placeholder="输入关键字搜索" />
            <button type="submit" class="submit">搜索</button>
          </form>

          <!-- ========================================== -->
          <!-- 🌟 主题设置面板 UI 开始 🌟 -->
          <!-- ========================================== -->
          <div class="theme-settings-wrapper">
            <!-- 触发按钮 -->
            <button class="theme-settings-toggle" aria-label="主题设置">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
            </button>

            <!-- 弹出的面板 -->
            <div class="theme-settings-panel">
              <!-- 1. 界面模式 -->
              <div class="setting-group">
                <div class="setting-title">界面模式</div>
                <div class="setting-options">
                  <button data-theme-action="mode" data-theme-value="light" class="opt-btn">☀️</button>
                  <button data-theme-action="mode" data-theme-value="dark" class="opt-btn">🌙</button>
                  <button data-theme-action="mode" data-theme-value="system" class="opt-btn">💻</button>
                </div>
              </div>
              <!-- 2. 主题预设 -->
              <div class="setting-group">
                <div class="setting-title">主题预设</div>
                <div class="setting-options color-options">
                  <button data-theme-action="color" data-theme-value="blue" class="color-btn blue"></button>
                  <button data-theme-action="color" data-theme-value="green" class="color-btn green"></button>
                  <button data-theme-action="color" data-theme-value="orange" class="color-btn orange"></button>
                  <button data-theme-action="color" data-theme-value="purple" class="color-btn purple"></button>
                </div>
              </div>
              <!-- 3. 字号预设 -->
              <div class="setting-group">
                <div class="setting-title">字号预设</div>
                <div class="setting-options">
                  <button data-theme-action="font" data-theme-value="small" class="opt-btn font-btn">A</button>
                  <button data-theme-action="font" data-theme-value="medium" class="opt-btn font-btn">A</button>
                  <button data-theme-action="font" data-theme-value="large" class="opt-btn font-btn">A</button>
                </div>
              </div>
            </div>
          </div>
          <!-- ========================================== -->
          <!-- 🌟 主题设置面板 UI 结束 🌟 -->
          <!-- ========================================== -->

        </div>
        <div class="col-mb-12">
          <nav id="nav-menu" class="clearfix" role="navigation">
            <a class:list={[{ current: isIndex }]} href={urls.siteUrl + '/'}>首页</a>
            {pages.map((page) => (
              <a href={page.permalink} title={page.title}>{page.title}</a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </header>

  <div id="body">
    <div class="container">
      <div class="row">
        <div class="col-mb-12 col-8" id="main" role="main">
          {posts.length === 0 ? (
            <article class="post">
              <h2 class="post-title">暂时没有文章</h2>
              <div class="post-content">
                <p>这里还没有任何文章，请通过管理后台发布第一篇文章。</p>
              </div>
            </article>
          ) : (
            posts.map((post) => {
              // ⚠️ 只在这里处理摘要，不影响其他任何结构
              let excerpt = post.excerpt || '';
              const rawContent = post.content || post.excerpt || '';
              if (rawContent) {
                const cleanContent = rawContent
                  .replace(/<p class="more">.*?<\/p>/g, '')
                  .replace(/- 阅读剩余部分 -/g, '')
                  .trim();
                excerpt = renderContentExcerpt(cleanContent, '- 阅读剩余部分 -', post.permalink);
              }
              
              return (
                <article class="post" itemscope itemtype="http://schema.org/BlogPosting">
                  <h2 class="post-title" itemprop="name headline">
                    <a itemprop="url" href={post.permalink}>{post.title}</a>
                  </h2>
                  <ul class="post-meta">
                    <li itemprop="author" itemscope itemtype="http://schema.org/Person">
                      作者: <a
                        itemprop="name"
                        href={post.author ? buildAuthorLink(post.author.uid, urls.siteUrl) : '#'}
                        rel="author"
                      >
                        {post.author?.screenName || post.author?.name || '未知'}
                      </a>
                    </li>
                    <li>
                      时间: <time datetime={new Date((post.created) * 1000).toISOString()} itemprop="datePublished">
                        {formatDate(post.created, 'Y-m-d', options.timezone)}
                      </time>
                    </li>
                    {post.categories.length > 0 && (
                      <li>
                        分类: {post.categories.map((c, i) => (
                          <>{i > 0 && ', '}<a href={c.permalink}>{c.name}</a></>
                        ))}
                      </li>
                    )}
                    <li itemprop="interactionCount">
                      <a itemprop="discussionUrl" href={`${post.permalink}#comments`}>
                        {post.commentsNum === 0 ? '评论' : `${post.commentsNum} 条评论`}
                      </a>
                    </li>
                  </ul>
                  {/* ⚠️ 这里用处理后的 excerpt，其他属性完全没动 */}
                  <div class="post-content" itemprop="articleBody" set:html={excerpt} />
                </article>
              );
            })
          )}

          {pagination.totalPages > 1 && (
            <nav class="page-navigator">
              {pagination.hasPrev && (
                <a class="prev" href={pagination.prevUrl!}>&laquo; 前一页</a>
              )}
              {pagination.hasNext && (
                <a class="next" href={pagination.nextUrl!}>后一页 &raquo;</a>
              )}
            </nav>
          )}
        </div>

        {sidebarData && (
          <div class="col-mb-12 col-offset-1 col-3 kit-hidden-tb" id="secondary" role="complementary">
            {sidebarData.recentPosts && sidebarData.recentPosts.length > 0 && (
              <section class="widget">
                <h3 class="widget-title">最新文章</h3>
                <ul class="widget-list">
                  {sidebarData.recentPosts.map((p) => (
                    <li><a href={p.permalink}>{p.title}</a></li>
                  ))}
                </ul>
              </section>
            )}
            {sidebarData.recentComments && sidebarData.recentComments.length > 0 && (
              <section class="widget">
                <h3 class="widget-title">最近回复</h3>
                <ul class="widget-list">
                  {sidebarData.recentComments.map((c) => (
                    <li><a href={c.permalink}>{c.author}</a>: {c.excerpt}</li>
                  ))}
                </ul>
              </section>
            )}
            {sidebarData.categories && sidebarData.categories.length > 0 && (
              <section class="widget">
                <h3 class="widget-title">分类</h3>
                <ul class="widget-list">
                  {sidebarData.categories.map((cat) => (
                    <li><a href={cat.permalink}>{cat.name} ({cat.count})</a></li>
                  ))}
                </ul>
              </section>
            )}

                 {/* 隐藏 归档 */}
              {/* 
            {sidebarData.archives && sidebarData.archives.length > 0 && (
              <section class="widget">
                <h3 class="widget-title">归档</h3>
                <ul class="widget-list">
                  {sidebarData.archives.map((archive) => (
                    <li><a href={archive.permalink}>{archive.date}</a></li>
                  ))}
                </ul>
              </section>
            )}
            */}

            <section class="widget">
              <h3 class="widget-title">其它</h3>
              <ul class="widget-list">
                {isLoggedIn ? (
                  <>
                    <li class="last">
                      <a href={urls.adminUrl}>进入后台 ({user?.screenName || user?.name})</a>
                    </li>
                    <li><form method="post" action={urls.logoutUrl} class="logout-form"><button type="submit">退出</button></form></li>
                  </>
                ) : (
                  <li class="last"><a href={urls.loginUrl}>登录</a></li>
                )}
                <li><a href={urls.feedUrl}>文章 RSS</a></li>
                <li><a href={urls.commentsFeedUrl}>评论 RSS</a></li>
              </ul>
            </section>
          </div>
        )}
      </div>
    </div>
  </div>

  <footer id="footer" role="contentinfo">
    &copy; {new Date().getFullYear()} <a href={urls.siteUrl}>{options.title}</a>.
    由 <a href="#">Typecho CF</a> 强力驱动.
  </footer>
</Base>
