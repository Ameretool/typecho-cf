---
/**
 * Default theme — Post detail component
 */
import Base from '@/layouts/Base.astro';
import CommentList from './CommentList.astro';
import type { ThemePostProps } from '@/lib/theme-props';
import { formatDate, buildAuthorLink } from '@/lib/content';

type Props = ThemePostProps;

const {
  options, urls, user, isLoggedIn, pages, sidebarData, currentPath, pluginCtx,
  post, author, categories, tags, comments, commentOptions,
  commentPagination, prevPost, nextPost, gravatarMap,
} = Astro.props;

const isIndex = currentPath === '/';
const totalComments = commentPagination.totalComments;
---
<Base
  title={post.title}
  options={options}
  urls={urls}
  user={user}
  isLoggedIn={isLoggedIn}
  pluginCtx={pluginCtx}
  pageContext={{ hasComments: commentOptions.allowComment, pageType: 'post' }}
>
  <header id="header" class="clearfix site-header-sticky">
    <div class="container">
      <div class="header-flex">
        <div class="header-left">
          <a id="logo" href={urls.siteUrl + '/'} class="brand-logo">
            <img src="/logo.png" alt="Logo" class="site-logo-img" />
            <span>{options.title}</span>
          </a>
          <nav id="nav-menu" class="desktop-nav kit-hidden-tb" role="navigation">
            <a class:list={[{ current: isIndex }]} href={urls.siteUrl + '/'}>首页</a>
            {pages.map((p) => (
              <a href={p.permalink} title={p.title}>{p.title}</a>
            ))}
          </nav>
        </div>

        <div class="header-right">
          <div class="site-search kit-hidden-tb">
            <form id="search" method="post" action={urls.siteUrl + '/'} role="search">
              <label for="s" class="sr-only">搜索关键字</label>
              <input type="text" id="s" name="s" class="text" placeholder="搜索..." />
              <button type="submit" class="submit">搜索</button>
            </form>
          </div>
          <div class="mobile-menu-wrapper kit-hidden-pc">
            <button id="mobile-menu-btn" class="my-mobile-btn" aria-label="打开菜单">
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>
            <div id="mobile-menu-list" class="my-mobile-dropdown">
              <a class:list={[{ current: isIndex }]} href={urls.siteUrl + '/'}>首页</a>
              {pages.map((p) => (
                <a href={p.permalink} title={p.title}>{p.title}</a>
              ))}
            </div>
          </div>
          <div class="theme-settings-wrapper">
            <button class="theme-settings-toggle" aria-label="主题设置">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            </button>
            <div class="theme-settings-panel" style="top: 45px; right: 0; bottom: auto;">
              <div class="setting-group">
                <div class="setting-title">界面模式</div>
                <div class="setting-options">
                  <button data-theme-action="mode" data-theme-value="light" class="opt-btn">☀️</button>
                  <button data-theme-action="mode" data-theme-value="dark" class="opt-btn">🌙</button>
                  <button data-theme-action="mode" data-theme-value="system" class="opt-btn">💻</button>
                </div>
              </div>
              <div class="setting-group">
                <div class="setting-title">主题预设</div>
                <div class="setting-options color-options">
                  <button data-theme-action="color" data-theme-value="blue" class="color-btn blue"></button>
                  <button data-theme-action="color" data-theme-value="green" class="color-btn green"></button>
                  <button data-theme-action="color" data-theme-value="orange" class="color-btn orange"></button>
                  <button data-theme-action="color" data-theme-value="purple" class="color-btn purple"></button>
                </div>
              </div>
              <div class="setting-group">
                <div class="setting-title">字号预设</div>
                <div class="setting-options">
                  <button data-theme-action="font" data-theme-value="small" class="opt-btn font-btn">A</button>
                  <button data-theme-action="font" data-theme-value="medium" class="opt-btn font-btn">A</button>
                  <button data-theme-action="font" data-theme-value="large" class="opt-btn font-btn">A</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div id="body">
    <div class="container">
      <div class="row">
        <div class="col-mb-12 col-8" id="main" role="main">
          <article class="post" itemscope itemtype="http://schema.org/BlogPosting">
            <h1 class="post-title" itemprop="name headline">
              <a itemprop="url" href={post.permalink}>{post.title}</a>
            </h1>
            <ul class="post-meta">
              <li itemprop="author" itemscope itemtype="http://schema.org/Person">
                作者: <a itemprop="name" href={author ? buildAuthorLink(author.uid, urls.siteUrl) : '#'} rel="author">{author?.screenName || author?.name || '未知'}</a>
              </li>
              <li>时间: <time datetime={new Date(post.created * 1000).toISOString()} itemprop="datePublished">{formatDate(post.created, 'Y-m-d', options.timezone)}</time></li>
              {categories.length > 0 && (
                <li>分类: {categories.map((c, i) => (<>{i > 0 && ', '}<a href={c.permalink}>{c.name}</a></>))}</li>
              )}
            </ul>

            {post.hasPassword && !post.passwordVerified ? (
              <div class="post-content">
                <form method="get" action={post.permalink}>
                  <p>请输入密码访问此内容：</p>
                  <p><input type="password" name="password" class="text" /></p>
                  <p><button type="submit" class="submit">提交</button></p>
                </form>
              </div>
            ) : (
              <div class="post-content" itemprop="articleBody" set:html={post.content} />
            )}

            {tags.length > 0 && (
              <p itemprop="keywords" class="tags">
                标签: {tags.map((t, i) => (<>{i > 0 && ', '}<a href={t.permalink}>{t.name}</a></>))}
              </p>
            )}
          </article>

          {(!post.hasPassword || post.passwordVerified) && (
            <div id="comments">
              {totalComments > 0 && (
                <>
                  <h3>{totalComments === 1 ? '仅有一条评论' : `已有 ${totalComments} 条评论`}</h3>
                  <ol class="comment-list">
                    <CommentList comments={comments} commentOptions={commentOptions} gravatarMap={gravatarMap} permalink={post.permalink} />
                  </ol>
                  {commentPagination.enabled && commentPagination.totalPages > 1 && (
                    <nav class="page-navigator comment-page-navigator" aria-label="评论分页">
                      {commentPagination.prevUrl && <a class="prev" href={commentPagination.prevUrl} rel="prev">
