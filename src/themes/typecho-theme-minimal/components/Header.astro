---
type Props = {
  options: any;
  urls: any;
  pages: any[];
  currentPath: string;
};

const { options, urls, pages, currentPath } = Astro.props;
const isIndex = currentPath === '/';
---

<header id="header" class="clearfix site-header-sticky">
  <div class="container header-container">
    
    <!-- 左侧：Logo + 导航 -->
    <div class="header-left">
      <div class="nav-row">
        <!-- 站点标题文字，在手机端通过 CSS 隐藏 -->
        <a href={urls.siteUrl + '/'} class="site-logo">
          <img src="/logo.png" alt={options.title} onerror="this.style.display='none'" />
          <span class="site-title">{options.title}</span>
        </a>
        
        <nav id="nav-menu" class="clearfix" role="navigation">
          <a class:list={[{ current: isIndex }]} href={urls.siteUrl + '/'}>首页</a>
          {pages.map((page) => (
            <a class:list={[{ current: currentPath === page.permalink }]} href={page.permalink} title={page.title}>{page.title}</a>
          ))}
        </nav>
      </div>
      
      <p class="description">{options.description}</p>
    </div>

    <!-- 右侧：搜索框 + 齿轮面板 (PC端使用) -->
    <div class="header-right desktop-only">
      <div class="site-search">
        <form id="search" method="post" action={urls.siteUrl + '/'} role="search">
          <input type="text" id="s" name="s" placeholder="输入关键字搜索" />
          <button type="submit" class="submit">搜索</button>
        </form>
      </div>

      <div class="theme-settings-wrapper">
        <button class="theme-settings-toggle" aria-label="主题设置">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        </button>

        <div class="theme-settings-panel">
          <div class="setting-group">
            <div class="setting-title">界面模式</div>
            <div class="setting-options">
              <button data-theme-action="mode" data-theme-value="light" class="opt-btn">☀️</button>
              <button data-theme-action="mode" data-theme-value="dark" class="opt-btn">🌙</button>
              <button data-theme-action="mode" data-theme-value="system" class="opt-btn">💻</button>
            </div>
          </div>
          <div class="setting-group">
            <div class="setting-title">主题预设</div>
            <div class="setting-options color-options">
              <button data-theme-action="color" data-theme-value="blue" class="color-btn blue"></button>
              <button data-theme-action="color" data-theme-value="green" class="color-btn green"></button>
              <button data-theme-action="color" data-theme-value="orange" class="color-btn orange"></button>
              <button data-theme-action="color" data-theme-value="purple" class="color-btn purple"></button>
            </div>
          </div>
          <div class="setting-group">
            <div class="setting-title">字号预设</div>
            <div class="setting-options">
              <button data-theme-action="font" data-theme-value="small" class="opt-btn font-btn">A</button>
              <button data-theme-action="font" data-theme-value="medium" class="opt-btn font-btn">A</button>
              <button data-theme-action="font" data-theme-value="large" class="opt-btn font-btn">A</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 移动端专属：一键亮暗切换按钮 -->
    <div class="mobile-only mobile-theme-toggle">
      <button id="simple-theme-btn" aria-label="切换主题">🌓</button>
    </div>

  </div>
</header>

<style>
  /* ==============================
     基础与 PC 端布局
     ============================== */
  .site-header-sticky {
    background-color: var(--bg-color);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 999;
    padding: 15px 0;
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center; 
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
  }

  .nav-row {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-color);
  }

  .site-logo img { height: 36px; width: auto; border-radius: 4px; }
  .site-title { font-size: 1.6em; font-weight: bold; white-space: nowrap; }

  #nav-menu {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 0;
    padding: 0;
  }

  #nav-menu a {
    color: var(--text-color);
    text-decoration: none;
    font-size: 15px;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
  }

  #nav-menu a:hover, 
  #nav-menu a.current {
    color: var(--accent-color);
    border-bottom-color: var(--accent-color);
  }

  .description {
    margin: 8px 0 0 0;
    font-size: 13px;
    color: var(--text-color);
    opacity: 0.6;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .site-search form {
    display: flex;
    align-items: center;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 18px;
    overflow: hidden;
    height: 36px;
    margin: 0;
  }

  .site-search input {
    border: none;
    background: transparent;
    padding: 0 15px;
    outline: none;
    color: var(--text-color);
    width: 160px;
    font-size: 14px;
  }

  .site-search .submit {
    background: var(--accent-color);
    color: #fff;
    border: none;
    padding: 0 16px;
    height: 100%;
    cursor: pointer;
    font-size: 14px;
  }

  /* 齿轮面板 */
  .theme-settings-wrapper { position: relative; display: flex; align-items: center; }
  .theme-settings-toggle { background: transparent; border: none; color: var(--text-color); cursor: pointer; padding: 5px; display: flex; align-items: center; }
  .theme-settings-toggle:hover { color: var(--accent-color); }
  .theme-settings-panel {
    position: absolute; right: 0; top: 45px; width: 260px;
    background: var(--card-bg); border: 1px solid var(--border-color);
    border-radius: 12px; padding: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    display: none; z-index: 10000;
  }
  .theme-settings-wrapper.active .theme-settings-panel { display: block; }

  /* 默认隐藏移动端专属按钮 */
  .mobile-only { display: none; }

  /* ==============================
     手机端终极极简适配
     ============================== */
  @media (max-width: 768px) {
    .site-header-sticky { padding: 10px 0; }
    
    .header-container {
      display: flex;
      flex-direction: row; /* 强制横向排列 */
      align-items: center;
      justify-content: space-between;
      padding: 0 15px;
    }
    
    .header-left { 
      flex-direction: row; 
      align-items: center; 
      flex: 1;
      overflow: hidden; 
    }

    .nav-row { 
      flex-direction: row; 
      align-items: center; 
      gap: 15px; 
      width: 100%; 
    }

    /* 隐藏 HB 文字，保留 Logo 图片 */
    .site-title { display: none; }
    .site-logo img { height: 32px; }

    /* 隐藏副标题和 PC 端的右侧区域 */
    .description, .desktop-only { display: none; }

    /* 手机端导航：横向滑动 */
    #nav-menu {
      display: flex;
      overflow-x: auto;
      gap: 15px;
      padding: 0;
    }
    #nav-menu::-webkit-scrollbar { display: none; }
    #nav-menu a {
      white-space: nowrap;
      flex-shrink: 0;
      font-size: 16px; /* 稍微放大一点，因为没了背景色 */
      padding-bottom: 0;
      border: none;
      background: transparent;
      color: var(--text-color);
    }
    #nav-menu a.current {
      color: var(--accent-color);
      font-weight: bold;
    }

    /* 显示极简的小太阳/月亮切换 */
    .mobile-only { display: block; margin-left: 10px; }
    
    #simple-theme-btn {
      background: transparent;
      border: none;
      font-size: 22px;
      cursor: pointer;
      padding: 0;
      display: flex;
      align-items: center;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // === 1. PC 端的齿轮控制逻辑 ===
    const wrapper = document.querySelector('.theme-settings-wrapper');
    const toggle = document.querySelector('.theme-settings-toggle');
    if (toggle && wrapper) {
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        wrapper.classList.toggle('active');
      });
      document.addEventListener('click', (e) => {
        if (!wrapper.contains(e.target)) { wrapper.classList.remove('active'); }
      });
    }

    // === 2. 手机端极简小太阳的逻辑 (一键亮暗切换) ===
    const simpleBtn = document.getElementById('simple-theme-btn');
    if (simpleBtn) {
      // 初始化按钮图标
      let currentMode = document.documentElement.getAttribute('data-mode') || 'light';
      simpleBtn.textContent = currentMode === 'dark' ? '☀️' : '🌙';

      simpleBtn.addEventListener('click', () => {
        let mode = document.documentElement.getAttribute('data-mode');
        let newMode = mode === 'dark' ? 'light' : 'dark';
        
        // 改变全局主题模式
        document.documentElement.setAttribute('data-mode', newMode);
        // 记录到本地
        localStorage.setItem('theme-mode', newMode);
        
        // 切换图标
        simpleBtn.textContent = newMode === 'dark' ? '☀️' : '🌙';
      });
    }
  });
</script>
