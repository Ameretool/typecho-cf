---
// Standalone page — no Admin layout (user is not logged in).
const token = Astro.url.searchParams.get('token') || '';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="renderer" content="webkit" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
  <title>设置新密码</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="stylesheet" href="/css/normalize.css" />
  <link rel="stylesheet" href="/css/grid.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="typecho-login-wrap">
    <div class="typecho-login">
      <h1><a href="/">设置新密码</a></h1>
      {!token && <div class="message error"><p>缺少重置令牌。请从邮件中的链接访问。</p></div>}
      {token && <form action="/api/users/reset-password" method="post">
        <input type="hidden" name="token" value={token} />
        <p>
          <label for="password" class="sr-only">新密码</label>
          <input type="password" id="password" name="password" class="text w-100" placeholder="请输入新密码（至少 6 位）" required autofocus minlength="6" />
        </p>
        <p>
          <label for="confirm" class="sr-only">确认密码</label>
          <input type="password" id="confirm" name="confirm" class="text w-100" placeholder="再次输入新密码" required minlength="6" />
        </p>
        <p class="submit">
          <button type="submit" class="btn primary w-100">重置密码</button>
        </p>
      </form>}
      <p class="more-link">
        <a href="/admin/login">返回登录</a>
      </p>
    </div>
  </div>
</body>
</html>
