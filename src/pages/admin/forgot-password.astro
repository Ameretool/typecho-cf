---
// Standalone page — no Admin layout (user is not logged in).
// Pattern matches login.astro.
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="renderer" content="webkit" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
  <title>忘记密码</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="stylesheet" href="/css/normalize.css" />
  <link rel="stylesheet" href="/css/grid.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="typecho-login-wrap">
    <div class="typecho-login">
      <h1><a href="/">忘记密码</a></h1>
      <form action="/api/users/forgot-password" method="post">
        <p>
          <label for="email" class="sr-only">邮箱地址</label>
          <input type="email" id="email" name="email" class="text w-100" placeholder="请输入注册邮箱" required autofocus />
        </p>
        <p class="submit">
          <button type="submit" class="btn primary w-100">发送重置链接</button>
        </p>
      </form>
      <p class="more-link">
        <a href="/admin/login">返回登录</a>
      </p>
    </div>
  </div>
</body>
</html>
