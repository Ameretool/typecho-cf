---
import Layout from '../../layouts/Layout.astro';
import Archive from '../../themes/typecho-theme-minimal/components/Archive.astro';
import { getArchivePosts } from '../../lib/archive'; // 请确认这个路径是否存在

// 获取 URL 中的年份和月份
const { year, month } = Astro.params;

// 从数据库查询该年月的所有文章
const posts = await getArchivePosts({ year, month });

// 如果没有文章，返回 404
if (!posts || posts.length === 0) {
  return Astro.redirect('/404');
}
---

<Layout title={`${year}年${month}月归档`}>
  <Archive posts={posts} year={year} month={month} />
</Layout>
