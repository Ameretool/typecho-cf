---
/**
 * 独立的微型博客页面 /m (极简物理路由版)
 */
import { createContext } from '@/lib/context';
import { prepareIndexData } from '@/lib/page-data';
import Base from '@/layouts/Base.astro';
import { formatDate } from '@/lib/content';

const ctx = await createContext(Astro.locals, Astro.request);
const { options, urls } = ctx;

// 获取全站数据
const data = await prepareIndexData(ctx, Astro.request.url, Astro.locals, Astro.url);
const { posts, pages, user, isLoggedIn, pluginCtx } = data;

// 过滤碎碎念
const microPosts = (posts || []).filter((post: any) => {
  const hasCategory = post.categories?.some((c: any) => c.name === '碎碎念');
  const hasTag = post.tags?.some((t: any) => t.name === '碎碎念' || t.name === '微博');
  return hasCategory || hasTag;
});

const currentPath = '/m';
---
<Base 
  title={`动态 - ${options.title}`} 
  options={options} 
  urls={urls} 
  user={user} 
  isLoggedIn={isLoggedIn} 
  pluginCtx={pluginCtx}
>
  <!-- 👇 纯手写极简导航栏（不依赖任何主题组件，自带黑夜模式按钮） 👇 -->
  <header id="header" style="border-bottom: 1px solid var(--border-color); padding: 15px 0; position: sticky; top: 0; background: var(--bg-color); z-index: 100;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; max-width: 800px; margin: 0 auto; padding: 0 20px;">
      
      <!-- 左侧：Logo + 导航 -->
      <div style="display: flex; align-items: center; gap: 20px;">
        <a href={urls.siteUrl + '/'} style="font-size: 1.2rem; font-weight: bold; color: var(--text-color); text-decoration: none;">
          {options.title}
        </a>
        
        <nav style="display: flex; gap: 15px;">
          <a href={urls.siteUrl + '/'} style="color: var(--text-color); text-decoration: none; opacity: 0.7;">首页</a>
          <a href={urls.siteUrl + '/m'} style="color: var(--accent-color); text-decoration: none; font-weight: bold;">动态</a>
        </nav>
      </div>

      <!-- 右侧：黑夜模式切换按钮 -->
      <button id="theme-btn" style="background: transparent; border: none; font-size: 1.2rem; cursor: pointer;" title="切换模式">🌓</button>
    </div>
  </header>

  <!-- 正文内容区 -->
  <div id="body">
    <div class="container" style="max-width: 640px; margin: 40px auto; padding: 0 20px;">
      
      <div style="text-align: center; margin-bottom: 40px; opacity: 0.6; font-size: 14px; letter-spacing: 1px;">
        · 记录瞬间的碎碎念 ·
      </div>

      {microPosts.length === 0 ? (
        <p style="text-align: center; opacity: 0.5; margin-top: 50px;">当前页没有动态哦~</p>
      ) : (
        <div class="micro-timeline">
          {microPosts.map((post: any) => (
            <div style="margin-bottom: 40px; padding-bottom: 24px; border-bottom: 1px dashed var(--border-color);">
              
              <!-- 头部：作者、时间 -->
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <div style="font-size: 13px; color: #8a8f9a; display: flex; align-items: center; gap: 8px;">
                  <img src={post.author?.avatarUrl || '/img/avatar.svg'} alt="avatar" style="width: 20px; height: 20px; border-radius: 50%; opacity: 0.8;" />
                  <span>{post.author?.screenName || post.author?.name || 'HB'}</span>
                </div>
                <time datetime={new Date((post.created) * 1000).toISOString()} style="font-size: 12px; color: #8a8f9a;">
                  {formatDate(post.created, 'Y.m.d H:i', options.timezone)}
                </time>
              </div>

              <!-- 核心修复：正文渲染。利用 set:html 将文章内容或摘要渲染出来 -->
              <div class="post-content" set:html={post.content || post.excerpt} style="font-size: 15px; line-height: 1.8; color: var(--text-color); word-break: break-word;"></div>

              <!-- 评论跳转 -->
              <div style="margin-top: 16px; font-size: 13px; text-align: right;">
                <a href={`${post.permalink}#comments`} style="color: var(--accent-color); text-decoration: none; border: none;">
                  💬 {post.commentsNum === 0 ? '去评论' : `${post.commentsNum} 条评论`}
                </a>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</Base>

<!-- 👇 手写黑夜模式切换逻辑 👇 -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('theme-btn');
    if (!btn) return;
    
    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const currentMode = html.getAttribute('data-mode');
      const newMode = currentMode === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-mode', newMode);
      
      // 更新你 Base.astro 里的本地存储偏好
      localStorage.setItem('hbw-theme-pref', newMode);
    });
  });
</script>
