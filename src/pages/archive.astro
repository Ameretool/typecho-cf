---
/**
 * ============================================================
 *  归档页面 - /archive/ (动态适配主题版)
 * ============================================================
 */
import Base from '@/layouts/Base.astro';
import { createContext } from '@/lib/context';
import { schema } from '@/db';
import { and, eq, desc } from 'drizzle-orm';
import { formatDate, buildPermalink } from '@/lib/content';

const ctx = await createContext(Astro.locals, Astro.request);
const { db, options, urls, user, isLoggedIn, pluginCtx } = ctx;

// 👇 核心修复：动态获取当前激活的主题，并加载对应的组件 👇
const currentTheme = options.theme || 'typecho-theme-minimal'; 
let Header, Footer;

try {
  // 根据当前主题名，动态引入组件
  const headerModule = await import(`../themes/${currentTheme}/components/Header.astro`);
  const footerModule = await import(`../themes/${currentTheme}/components/Footer.astro`);
  Header = headerModule.default;
  Footer = footerModule.default;
} catch (e) {
  // 如果找不到组件（兜底），给个空标签防止页面崩溃
  Header = () => null;
  Footer = () => null;
}

// 查数据库...
const allPosts = await db.query.contents.findMany({
  where: and(
    eq(schema.contents.type, 'post'),
    eq(schema.contents.status, 'publish')
  ),
  orderBy: [desc(schema.contents.created)],
});

// 分组逻辑... (保持不变)
const postsByYearMonth: Record<string, Record<string, any[]>> = {};
allPosts.forEach((post: any) => {
  const created = Number(post?.created);
  if (!created || isNaN(created)) return;
  const d = new Date(created * 1000);
  const year = String(d.getFullYear());
  const month = String(d.getMonth() + 1).padStart(2, '0');
  if (!postsByYearMonth[year]) postsByYearMonth[year] = {};
  if (!postsByYearMonth[year][month]) postsByYearMonth[year][month] = [];
  post.permalink = buildPermalink(
    { cid: post.cid, slug: post.slug, type: post.type, created: post.created },
    urls.siteUrl,
    options.permalinkPattern as string | undefined,
  );
  postsByYearMonth[year][month].push(post);
});

const sortedYears = Object.keys(postsByYearMonth).sort((a, b) => Number(b) - Number(a));

const { loadSidebarAndNav } = await import('@/lib/sidebar');
const { sidebarData, pages } = await loadSidebarAndNav(
  ctx, db, urls.siteUrl,
  options.permalinkPattern as string | undefined,
  options.categoryPattern as string | undefined,
  options.pagePattern as string | undefined,
  options.cacheVersion,
);

const currentPath = '/archive/';
---

<Base
  title="文章归档"
  options={options}
  urls={urls}
  user={user}
  isLoggedIn={isLoggedIn}
  pluginCtx={pluginCtx}
>
  <!-- 👇 动态渲染当前主题的 Header 👇 -->
  {Header && <Header options={options} urls={urls} pages={pages} currentPath={currentPath} />}

  <div id="body">
    <div class="container">
      <div class="row">
        <div class="col-mb-12 col-8 transition-fade" id="main" role="main">
          <h3 class="archive-title">文章归档</h3>

          {sortedYears.length === 0 ? (
            <article class="post">
              <div class="post-content"><p>暂时没有文章。</p></div>
            </article>
          ) : (
            sortedYears.map((year) => (
              <section class="archive-year" style="margin-bottom: 2rem;">
                <h4 class="archive-year-title">{year} 年</h4>
                {Object.keys(postsByYearMonth[year])
                  .sort((a, b) => Number(b) - Number(a))
                  .map((month) => {
                    const postsInMonth = postsByYearMonth[year][month];
                    return (
                      <details class="archive-month" style="margin-bottom: 0.5rem;">
                        <summary class="archive-month-summary">
                          {year} 年 {month} 月 <span class="archive-count">({postsInMonth.length} 篇)</span>
                        </summary>
                        <ul class="archive-post-list">
                          {postsInMonth.map((post: any) => (
                            <li class="archive-post-row">
                              <span class="archive-post-date">
                                {formatDate(Number(post.created) || 0, 'm-d', options.timezone)}
                              </span>
                              <a href={post.permalink} class="archive-post-title">{post.title || '无标题'}</a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    );
                  })}
              </section>
            ))
          )}
        </div>

        <!-- 侧边栏 -->
        <div class="col-mb-12 col-offset-1 col-3 kit-hidden-tb" id="secondary" role="complementary">
          {sidebarData && (
            <>
              {/* 侧边栏代码保持你原来的即可 */}
              {sidebarData.recentPosts && sidebarData.recentPosts.length > 0 && (
                <section class="widget"><h3 class="widget-title">最新文章</h3><ul class="widget-list">{sidebarData.recentPosts.map((p) => (<li><a href={p.permalink}>{p.title}</a></li>))}</ul></section>
              )}
              {sidebarData.categories && sidebarData.categories.length > 0 && (
                <section class="widget"><h3 class="widget-title">分类</h3><ul class="widget-list">{sidebarData.categories.map((cat) => (<li><a href={cat.permalink}>{cat.name} ({cat.count})</a></li>))}</ul></section>
              )}
              <section class="widget">
                <h3 class="widget-title">其它</h3>
                <ul class="widget-list">
                  {isLoggedIn ? (
                    <><li class="last"><a href={urls.adminUrl}>进入后台 ({user?.screenName || user?.name})</a></li><li><form method="post" action={urls.logoutUrl} class="logout-form"><button type="submit">退出</button></form></li></>
                  ) : (
                    <li class="last"><a href={urls.loginUrl}>登录</a></li>
                  )}
                  <li><a href={urls.feedUrl}>文章 RSS</a></li>
                  <li><a href={urls.commentsFeedUrl}>评论 RSS</a></li>
                </ul>
              </section>
            </>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- 👇 动态渲染当前主题的 Footer 👇 -->
  {Footer && <Footer options={options} urls={urls} />}
</Base>

<style>
/* 样式保持不变 */
.archive-post-list { list-style: none; padding: 0; margin: 0; border: 1px solid var(--border-color); border-top: none; border-radius: 0 0 4px 4px; }
.archive-post-row { display: flex; gap: 1rem; align-items: baseline; padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--border-color); transition: background-color 0.15s ease; }
.archive-post-row:last-child { border-bottom: none; }
.archive-post-row:hover { background-color: var(--card-bg); }
.archive-post-date { color: var(--text-color); opacity: 0.6; font-size: 0.9rem; flex-shrink: 0; min-width: 80px; }
.archive-post-title { font-size: 1rem; text-decoration: none; color: var(--accent-color); }
.archive-post-title:hover { text-decoration: underline; color: var(--text-color); }
.archive-year-title { font-size: 1.2rem; color: var(--text-color) !important; border-bottom: 1px solid var(--border-color) !important; padding-bottom: 0.5rem; margin-bottom: 1rem; }
.archive-month-summary { cursor: pointer; padding: 0.5rem 0.8rem; background: var(--card-bg) !important; border: 1px solid var(--border-color) !important; border-radius: 4px; font-size: 1rem; color: var(--accent-color) !important; user-select: none; transition: background 0.2s ease; }
.archive-month-summary:hover { background: var(--border-color) !important; }
.archive-count { color: var(--text-color) !important; opacity: 0.6; font-size: 0.85rem; margin-left: 0.5rem; }
</style>
