---
/**
 * ============================================================
 *  归档页面 - /archive/
 * ============================================================
 *  说明：
 *    1. 直接查数据库，拿全部已发布文章，不分页
 *    2. 按「年 → 月」分组
 *    3. 用 buildPermalink 生成正确的 /post/xxx.html 链接
 *    4. 导航栏 + 侧边栏与首页一致
 *    5. 完美适配暗黑模式，背景、边框、文字颜色全量动态化
 * ============================================================
 */
import Base from '@/layouts/Base.astro';
import { createContext } from '@/lib/context';
import { schema } from '@/db';
import { and, eq, desc } from 'drizzle-orm';
import { formatDate, buildPermalink } from '@/lib/content';

// 1. 初始化上下文
const ctx = await createContext(Astro.locals, Astro.request);
const { db, options, urls, user, isLoggedIn, pluginCtx } = ctx;

// 2. 直接查数据库，拿全部已发布文章（不分页）
const allPosts = await db.query.contents.findMany({
  where: and(
    eq(schema.contents.type, 'post'),
    eq(schema.contents.status, 'publish')
  ),
  orderBy: [desc(schema.contents.created)],
});

// 3. 按「年 → 月」分组，并顺便算 permalink
const postsByYearMonth: Record<string, Record<string, any[]>> = {};
allPosts.forEach((post: any) => {
  const created = Number(post?.created);
  if (!created || isNaN(created)) return;
  const d = new Date(created * 1000);
  const year = String(d.getFullYear());
  const month = String(d.getMonth() + 1).padStart(2, '0');
  if (!postsByYearMonth[year]) postsByYearMonth[year] = {};
  if (!postsByYearMonth[year][month]) postsByYearMonth[year][month] = [];
  // 用 buildPermalink 生成正确的 /post/xxx.html 链接
  post.permalink = buildPermalink(
    { cid: post.cid, slug: post.slug, type: post.type, created: post.created },
    urls.siteUrl,
    options.permalinkPattern as string | undefined,
  );
  postsByYearMonth[year][month].push(post);
});

// 4. 年份倒序
const sortedYears = Object.keys(postsByYearMonth).sort((a, b) => Number(b) - Number(a));

// 5. 侧边栏和导航数据
const { loadSidebarAndNav } = await import('@/lib/sidebar');
const { sidebarData, pages } = await loadSidebarAndNav(
  ctx,
  db,
  urls.siteUrl,
  options.permalinkPattern as string | undefined,
  options.categoryPattern as string | undefined,
  options.pagePattern as string | undefined,
  options.cacheVersion,
);
---

<Base
  title="文章归档"
  options={options}
  urls={urls}
  user={user}
  isLoggedIn={isLoggedIn}
  pluginCtx={pluginCtx}
>
  <header id="header" class="clearfix">
    <div class="container">
      <div class="row">
        <div class="site-name col-mb-12 col-9">
          <a id="logo" href={urls.siteUrl + '/'}>{options.title}</a>
          <p class="description">{options.description}</p>
        </div>
        <div class="col-mb-12">
          <nav id="nav-menu" class="clearfix" role="navigation">
            <a href={urls.siteUrl + '/'}>首页</a>
            <a href={urls.siteUrl + '/archive/'} class="current">归档</a>
            {(pages || []).map((page) => (
              <a href={page.permalink} title={page.title}>{page.title}</a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </header>

  <div id="body">
    <div class="container">
      <div class="row">
        <div class="col-mb-12 col-8 transition-fade" id="main" role="main">
          <h3 class="archive-title">文章归档</h3>

          {sortedYears.length === 0 ? (
            <article class="post">
              <div class="post-content">
                <p>暂时没有文章。</p>
              </div>
            </article>
          ) : (
            sortedYears.map((year) => (
              <section class="archive-year" style="margin-bottom: 2rem;">
                <!-- 年份标题：去掉了内联的写死颜色，完全交由 CSS 变量控制 -->
                <h4 class="archive-year-title">
                  {year} 年
                </h4>
                {Object.keys(postsByYearMonth[year])
                  .sort((a, b) => Number(b) - Number(a))
                  .map((month) => {
                    const postsInMonth = postsByYearMonth[year][month];
                    return (
                      <details class="archive-month" style="margin-bottom: 0.5rem;">
                        <!-- 月份折叠框：去掉了写死的白底和内联颜色 -->
                        <summary class="archive-month-summary">
                          {year} 年 {month} 月
                          <span class="archive-count">
                            ({postsInMonth.length} 篇)
                          </span>
                        </summary>
                        <ul class="archive-post-list">
                          {postsInMonth.map((post: any) => (
                            <li class="archive-post-row">
                              <span class="archive-post-date">
                                {formatDate(Number(post.created) || 0, 'm-d', options.timezone)}
                              </span>
                              <a href={post.permalink} class="archive-post-title">
                                {post.title || '无标题'}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    );
                  })}
              </section>
            ))
          )}
        </div>

        <div class="col-mb-12 col-offset-1 col-3 kit-hidden-tb" id="secondary" role="complementary">
          {sidebarData && (
            <>
              {sidebarData.recentPosts && sidebarData.recentPosts.length > 0 && (
                <section class="widget">
                  <h3 class="widget-title">最新文章</h3>
                  <ul class="widget-list">
                    {sidebarData.recentPosts.map((p) => (
                      <li><a href={p.permalink}>{p.title}</a></li>
                    ))}
                  </ul>
                </section>
              )}
              {sidebarData.recentComments && sidebarData.recentComments.length > 0 && (
                <section class="widget">
                  <h3 class="widget-title">最近回复</h3>
                  <ul class="widget-list">
                    {sidebarData.recentComments.map((c) => (
                      <li><a href={c.permalink}>{c.author}</a>: {c.excerpt}</li>
                    ))}
                  </ul>
                </section>
              )}
              {sidebarData.categories && sidebarData.categories.length > 0 && (
                <section class="widget">
                  <h3 class="widget-title">分类</h3>
                  <ul class="widget-list">
                    {sidebarData.categories.map((cat) => (
                      <li><a href={cat.permalink}>{cat.name} ({cat.count})</a></li>
                    ))}
                  </ul>
                </section>
              )}
              <section class="widget">
                <h3 class="widget-title">其它</h3>
                <ul class="widget-list">
                  {isLoggedIn ? (
                    <>
                      <li class="last">
                        <a href={urls.adminUrl}>进入后台 ({user?.screenName || user?.name})</a>
                      </li>
                      <li><form method="post" action={urls.logoutUrl} class="logout-form"><button type="submit">退出</button></form></li>
                    </>
                  ) : (
                    <li class="last"><a href={urls.loginUrl}>登录</a></li>
                  )}
                  <li><a href={urls.feedUrl}>文章 RSS</a></li>
                  <li><a href={urls.commentsFeedUrl}>评论 RSS</a></li>
                </ul>
              </section>
            </>
          )}
        </div>
      </div>
    </div>
  </div>

  <footer id="footer" role="contentinfo">
    &copy; {new Date().getFullYear()} <a href={urls.siteUrl}>{options.title}</a>.
   由 <a href="#">Typecho CF</a> 强力驱动.
  </footer>
</Base>

<style>
/* =========================================
 * 归档页面专属样式 (完美适配暗黑模式)
 * ========================================= */

/* 列表容器 */
.archive-post-list {
  list-style: none;
  padding: 0;
  margin: 0;
  /* 给列表底部加一条跟随主题的边框 */
  border: 1px solid var(--border-color);
  border-top: none;
  border-radius: 0 0 4px 4px;
}

/* 每一行文章 */
.archive-post-row {
  display: flex;
  gap: 1rem;
  align-items: baseline;
  padding: 0.6rem 0.8rem;
  /* 分割线使用主题边框变量，夜间会自动变深 */
  border-bottom: 1px solid var(--border-color); 
  transition: background-color 0.15s ease;
}
.archive-post-row:last-child {
  border-bottom: none;
}

/* 鼠标悬停时的微亮背景 */
.archive-post-row:hover {
  background-color: var(--card-bg); 
}

/* 左侧日期 */
.archive-post-date {
  color: var(--text-color);
  opacity: 0.6;
  font-size: 0.9rem;
  flex-shrink: 0;
  min-width: 80px;
}

/* 文章标题 */
.archive-post-title {
  font-size: 1rem;
  text-decoration: none;
  color: var(--accent-color);
}
.archive-post-title:hover {
  text-decoration: underline;
  color: var(--text-color);
}

/* 年份标题 (例如：2026 年) */
.archive-year-title {
  font-size: 1.2rem;
  color: var(--text-color) !important;
  border-bottom: 1px solid var(--border-color) !important;
  padding-bottom: 0.5rem;
  margin-bottom: 1rem;
}

/* 月份折叠框 (例如：2026 年 10 月) */
.archive-month-summary {
  cursor: pointer;
  padding: 0.5rem 0.8rem;
  /* 使用卡片背景色，完美融入亮色/暗色模式 */
  background: var(--card-bg) !important;
  border: 1px solid var(--border-color) !important;
  border-radius: 4px;
  font-size: 1rem;
  color: var(--accent-color) !important;
  user-select: none;
  transition: background 0.2s ease;
}

/* 月份折叠框悬停效果 */
.archive-month-summary:hover {
  background: var(--border-color) !important;
}

/* 篇数统计小字 */
.archive-count {
  color: var(--text-color) !important;
  opacity: 0.6;
  font-size: 0.85rem;
  margin-left: 0.5rem;
}
</style>
