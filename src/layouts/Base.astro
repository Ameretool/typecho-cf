---
// ============================================================
// 全局布局 Base.astro
// ============================================================
import type { SiteOptions } from '@/lib/options';
import type { computeUrls } from '@/lib/options';
import type { UserRow } from '@/lib/context';
import { getThemeStylesheets } from '@/lib/theme';
import { getClientSnippets, type PageContext, type HookContext } from '@/lib/plugin';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  options: SiteOptions;
  urls: ReturnType<typeof computeUrls>;
  user?: UserRow | null;
  isLoggedIn?: boolean;
  bodyClass?: string;
  pageContext?: PageContext;
  pluginCtx?: HookContext;
}

const {
  title,
  description,
  keywords,
  options,
  urls,
  user,
  isLoggedIn = false,
  bodyClass = '',
  pageContext,
  pluginCtx,
} = Astro.props;

const pageTitle = title ? `${title} - ${options.title}` : options.title;
const themeStylesheets = getThemeStylesheets(options.theme || 'typecho-theme-minimal');

// 收集插件客户端片段
const pluginSnippets = await getClientSnippets(pluginCtx ?? { activatedPlugins: new Set<string>() }, options as Record<string, any>, pageContext);
---
<!DOCTYPE html>
<html lang={options.lang === 'zh_CN' ? 'zh-CN' : 'en'}>
<head>
  <meta charset={options.charset || 'UTF-8'} />
  <meta name="renderer" content="webkit" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  {keywords && <meta name="keywords" content={keywords} />}
  {themeStylesheets.map((href) => (
    <link rel="stylesheet" href={href} />
  ))}
  <link rel="alternate" type="application/rss+xml" title={`${options.title} RSS`} href={urls.feedUrl} />
  <link rel="icon" href="/favicon.png" type="image/png">
  <slot name="head" />
  <Fragment set:html={pluginSnippets.headHtml} />

  <!-- ============================================================
       主题防闪烁及设置初始化脚本
       ============================================================ -->
  <script is:inline>
    (function() {
      // 1. 模式初始化
      const pref = localStorage.getItem('hbw-theme-pref') || 'system';
      let mode = pref;
      if (pref === 'system') {
        mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-pref', pref);
      document.documentElement.setAttribute('data-mode', mode);

      // 2. 配色初始化
      const color = localStorage.getItem('hbw-theme-color') || 'blue';
      document.documentElement.setAttribute('data-color', color);

      // 3. 字号初始化
      const font = localStorage.getItem('hbw-theme-font') || 'medium';
      document.documentElement.setAttribute('data-font', font);
    })();
  </script>

  <!-- ============================================================
       全站外链新窗口打开脚本
       ============================================================ -->
  <script is:inline>
    document.addEventListener('click', function(e) {
      const link = e.target.closest('a');
      if (
        link &&
        link.hostname &&
        link.hostname !== window.location.hostname
      ) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    }, true);
  </script>

  <!-- ============================================================
       回到顶部按钮样式
       ============================================================ -->
  <style is:global>
    #back-to-top {
      position: fixed !important;
      right: 20px !important;
      bottom: 30px !important;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--card-bg, #f5f5f5);
      color: var(--text-color, #444);
      border: 1px solid var(--border-color, #e0e0e0);
      cursor: pointer;
      z-index: 99999;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
      transition: opacity 0.3s ease, transform 0.3s ease, background 0.3s ease;
      opacity: 0;
      transform: translateY(10px);
      visibility: hidden;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      -webkit-tap-highlight-color: transparent;
    }
    #back-to-top.show {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }
    #back-to-top:hover {
      background: var(--border-color, #e0e0e0);
      transform: translateY(-2px);
    }
    #back-to-top:active {
      transform: scale(0.92);
    }
    @media (max-width: 768px) {
      #back-to-top {
        right: 12px !important;
        bottom: 80px !important;
        bottom: calc(80px + env(safe-area-inset-bottom, 0px)) !important;
        width: 44px;
        height: 44px;
      }
    }
  </style>
</head>
<body class={bodyClass}>
  <slot />
  <Fragment set:html={pluginSnippets.bodyHtml} />

  <!-- ============================================================
       回到顶部按钮脚本
       ============================================================ -->
  <script is:inline>
    (function () {
      function ensureButton() {
        if (document.getElementById('back-to-top')) return;

        var btn = document.createElement('button');
        btn.id = 'back-to-top';
        btn.setAttribute('aria-label', '返回顶部');
        btn.innerHTML = '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>';
        document.body.appendChild(btn);

        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      function onScroll() {
        var b = document.getElementById('back-to-top');
        if (!b) return;
        var threshold = window.innerWidth <= 768 ? 200 : 300;
        if (window.scrollY > threshold) {
          b.classList.add('show');
        } else {
          b.classList.remove('show');
        }
      }

      ensureButton();
      window.addEventListener('scroll', onScroll, { passive: true });

      document.addEventListener('swup:contentReplaced', function () {
        ensureButton();
        onScroll();
      });
      document.addEventListener('swup:pageView', function () {
        ensureButton();
        onScroll();
      });

      var observer = new MutationObserver(function () {
        ensureButton();
      });
      observer.observe(document.body, { childList: true, subtree: false });
    })();
  </script>

  <!-- ============================================================
       全局主题切换与面板控制逻辑
       ============================================================ -->
  <script is:inline>
    // 1. 监听系统主题变化
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
      if (localStorage.getItem('hbw-theme-pref') === 'system') {
        document.documentElement.setAttribute('data-mode', e.matches ? 'dark' : 'light');
      }
    });

    // 2. 切换函数
    window.setThemeMode = function(mode) {
      localStorage.setItem('hbw-theme-pref', mode);
      let actualMode = mode;
      if (mode === 'system') {
        actualMode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-pref', mode);
      document.documentElement.setAttribute('data-mode', actualMode);
    };

    window.setThemeColor = function(color) {
      localStorage.setItem('hbw-theme-color', color);
      document.documentElement.setAttribute('data-color', color);
    };

    window.setThemeFont = function(size) {
      localStorage.setItem('hbw-theme-font', size);
      document.documentElement.setAttribute('data-font', size);
    };

    // 3. 事件委托
    document.addEventListener('click', function(e) {
      // 处理面板开关
      const toggleBtn = e.target.closest('.theme-settings-toggle');
      if (toggleBtn) {
        toggleBtn.parentElement.classList.toggle('active');
        return; 
      }

      // 点击外部关闭面板
      const wrapper = document.querySelector('.theme-settings-wrapper');
      if (wrapper && !e.target.closest('.theme-settings-wrapper')) {
        wrapper.classList.remove('active');
      }

      // 处理设置切换
      const btn = e.target.closest('[data-theme-action]');
      if (!btn) return;
      
      const action = btn.getAttribute('data-theme-action');
      const value = btn.getAttribute('data-theme-value');
      
      if (action === 'mode') window.setThemeMode(value);
      if (action === 'color') window.setThemeColor(value);
      if (action === 'font') window.setThemeFont(value);
    });
  </script>

<!-- ========================================== -->
<!-- 评论区一键切换与 Giscus 挂载逻辑 (全局生效) -->
<!-- ========================================== -->

<!-- 1. 样式部分：定义切换按钮的外观 -->
<style is:inline>
  .comment-switcher-bar {
    display: flex; 
    gap: 10px; 
    margin-bottom: 20px; 
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-color);
  }
  .comment-switcher-bar button {
    padding: 8px 16px; 
    border-radius: 20px; 
    border: 1px solid var(--border-color);
    cursor: pointer; 
    transition: 0.3s; 
    font-size: 14px;
  }
</style>

<!-- 2. 逻辑部分：拦截页面、注入按钮、控制显示/隐藏、加载 Giscus -->
<script is:inline>
  // 等待页面的 DOM（HTML 结构）全部加载完毕后执行
  document.addEventListener('DOMContentLoaded', () => {
    
    // 【1】寻找原生评论区
    // 尝试寻找 ID 为 comments 的容器，或者寻找类名为 comment-list 的父元素
    const nativeComments = document.getElementById('comments') || document.querySelector('.comment-list')?.parentElement;
    
    // 如果当前页面没有评论区（比如首页、分类页），则直接终止执行，不显示切换按钮
    if (!nativeComments) return;

    // 【2】生成切换按钮的 HTML 代码
    const switcherHTML = `
      <div class="comment-switcher-bar">
        <!-- 默认高亮"站内评论" -->
        <button id="btn-native" style="background: var(--accent-color); color: #fff;">站内评论</button>
        <!-- 默认暗色"GitHub 评论" -->
        <button id="btn-giscus" style="background: var(--card-bg); color: var(--text-color);">GitHub 评论</button>
      </div>
    `;

    // 【3】创建 Giscus 的容器
    const giscusContainer = document.createElement('div');
    giscusContainer.id = 'giscus-comments';
    
    // ⭐️ 核心：Giscus 默认隐藏 (display: none)，只有点击按钮才显示
    giscusContainer.style.display = 'none'; 
    
    giscusContainer.style.marginTop = '20px';
    giscusContainer.innerHTML = '<div class="giscus"></div>'; // 占位，后续脚本会注入到这里

    // 【4】创建一个包装盒，用来包裹原来的站内评论
    const nativeWrapper = document.createElement('div');
    nativeWrapper.id = 'native-comments-wrapper';
    
    // ⭐️ 核心：站内评论默认显示 (display: block)
    nativeWrapper.style.display = 'block'; 

    // 【5】调整页面的 DOM 结构（把东西插进去）
    // 在原本的评论区前面，插入 Giscus 容器
    nativeComments.parentNode.insertBefore(giscusContainer, nativeComments);
    
    // 在原本的评论区前面，插入切换按钮
    nativeComments.parentNode.insertBefore(document.createRange().createContextualFragment(switcherHTML), nativeComments);
    
    // 在原本的评论区前面，插入包装盒
    nativeComments.parentNode.insertBefore(nativeWrapper, nativeComments);
    
    // 把原本的评论区代码，塞进刚刚创建的包装盒里面
    nativeWrapper.appendChild(nativeComments);

    // 【6】获取两个按钮，准备绑定点击事件
    const btnNative = document.getElementById('btn-native');
    const btnGiscus = document.getElementById('btn-giscus');
    let giscusLoaded = false; // 标记变量：防止用户多次点击导致 Giscus 被重复加载

    // 【7】点击"站内评论"按钮时执行的逻辑
    btnNative.addEventListener('click', () => {
      // ⭐️ 显示站内，隐藏 Giscus
      nativeWrapper.style.display = 'block';
      giscusContainer.style.display = 'none';
      
      // 按钮颜色样式的切换（站内变亮色，GitHub 变暗色）
      btnNative.style.background = 'var(--accent-color)';
      btnNative.style.color = '#fff';
      btnGiscus.style.background = 'var(--card-bg)';
      btnGiscus.style.color = 'var(--text-color)';
    });

    // 【8】点击"GitHub 评论"按钮时执行的逻辑
    btnGiscus.addEventListener('click', () => {
      // ⭐️ 显示 Giscus，隐藏站内
      nativeWrapper.style.display = 'none'; // 隐藏站内
      giscusContainer.style.display = 'block'; // 显示 Giscus
      
      // 按钮颜色样式的切换（GitHub 变亮色，站内变暗色）
      btnGiscus.style.background = 'var(--accent-color)';
      btnGiscus.style.color = '#fff';
      btnNative.style.background = 'var(--card-bg)';
      btnNative.style.color = 'var(--text-color)';

      // 如果是第一次点击，才真正去加载 Giscus 的 iframe（为了加快页面首次加载速度）
      if (!giscusLoaded) {
        loadGiscus();
        giscusLoaded = true;
      }
    });

    // 【9】加载 Giscus 的核心函数
    function loadGiscus() {
      const container = document.querySelector('.giscus');
      if (!container) return;
      
      // 判断当前网页是不是暗黑模式，决定给 Giscus 传什么主题
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      // 如果网页是暗色，Giscus 也用暗色主题；如果网页是亮色，Giscus 就用亮色主题
      const giscusTheme = isDark ? 'dark_tritanopia' : 'light_tritanopia'; 

      // 创建 script 标签，把你提供的参数全部塞进去
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.setAttribute('data-repo', 'WorkSpacesPro/guestbook');
      script.setAttribute('data-repo-id', 'R_kgDOOEORuw');
      script.setAttribute('data-category', 'General');
      script.setAttribute('data-category-id', 'DIC_kwDOOEORu84Cp384');
      script.setAttribute('data-mapping', 'pathname');
      script.setAttribute('data-strict', '0');
      script.setAttribute('data-reactions-enabled', '1');
      script.setAttribute('data-emit-metadata', '0');
      script.setAttribute('data-input-position', 'bottom');
      script.setAttribute('data-theme', giscusTheme); // 注入主题颜色
      script.setAttribute('data-lang', 'zh-CN');
      script.setAttribute('crossorigin', 'anonymous');
      script.async = true;

      // 把生成的 script 标签插入到页面的容器里，Giscus 就会开始加载了
      container.appendChild(script);
    }
  });

  // ==========================================
  // 【10】全局监听：当用户切换网页亮/暗模式时，让 Giscus 跟着变
  // ==========================================
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      // 如果发生变化的是 html 标签上的 'data-theme' 属性
      if (mutation.attributeName === 'data-theme') {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        
        // 去寻找页面里的 Giscus iframe
        const iframe = document.querySelector('iframe.giscus-frame');
        
        // 如果 Giscus 已经加载出来了，通过 postMessage 发送消息让它变色
        if (iframe) {
          const giscusTheme = isDark ? 'dark_tritanopia' : 'light_tritanopia';
          iframe.contentWindow.postMessage(
            { giscus: { setConfig: { theme: giscusTheme } } },
            'https://giscus.app'
          );
        }
      }
    });
  });
  
  // 开始监视 document.documentElement (也就是 <html> 标签) 的属性变化
  observer.observe(document.documentElement, { attributes: true });
</script>


</body>
</html>
