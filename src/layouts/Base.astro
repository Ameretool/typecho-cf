---
// ============================================================
// 全局布局 Base.astro
// ============================================================
import type { SiteOptions } from '@/lib/options';
import type { computeUrls } from '@/lib/options';
import type { UserRow } from '@/lib/context';
import { getThemeStylesheets } from '@/lib/theme';
import { getClientSnippets, type PageContext, type HookContext } from '@/lib/plugin';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  options: SiteOptions;
  urls: ReturnType<typeof computeUrls>;
  user?: UserRow | null;
  isLoggedIn?: boolean;
  bodyClass?: string;
  pageContext?: PageContext;
  pluginCtx?: HookContext;
}

const {
  title,
  description,
  keywords,
  options,
  urls,
  user,
  isLoggedIn = false,
  bodyClass = '',
  pageContext,
  pluginCtx,
} = Astro.props;

const pageTitle = title ? `${title} - ${options.title}` : options.title;
const themeStylesheets = getThemeStylesheets(options.theme || 'typecho-theme-minimal');

// 收集插件客户端片段
const pluginSnippets = await getClientSnippets(pluginCtx ?? { activatedPlugins: new Set<string>() }, options as Record<string, any>, pageContext);
---
<!DOCTYPE html>
<html lang={options.lang === 'zh_CN' ? 'zh-CN' : 'en'}>
<head>
  <meta charset={options.charset || 'UTF-8'} />
  <meta name="renderer" content="webkit" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  {keywords && <meta name="keywords" content={keywords} />}
  {themeStylesheets.map((href) => (
    <link rel="stylesheet" href={href} />
  ))}
  <link rel="alternate" type="application/rss+xml" title={`${options.title} RSS`} href={urls.feedUrl} />
  <link rel="icon" href="/favicon.png" type="image/png">
  <slot name="head" />
  <Fragment set:html={pluginSnippets.headHtml} />

  <!-- ============================================================
       主题防闪烁及设置初始化脚本
       ============================================================ -->
  <script is:inline>
    (function() {
      // 1. 模式初始化
      const pref = localStorage.getItem('hbw-theme-pref') || 'system';
      let mode = pref;
      if (pref === 'system') {
        mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-pref', pref);
      document.documentElement.setAttribute('data-mode', mode);

      // 2. 配色初始化
      const color = localStorage.getItem('hbw-theme-color') || 'blue';
      document.documentElement.setAttribute('data-color', color);

      // 3. 字号初始化
      const font = localStorage.getItem('hbw-theme-font') || 'medium';
      document.documentElement.setAttribute('data-font', font);
    })();
  </script>

  <!-- ============================================================
       全站外链新窗口打开脚本
       ============================================================ -->
  <script is:inline>
    document.addEventListener('click', function(e) {
      const link = e.target.closest('a');
      if (
        link &&
        link.hostname &&
        link.hostname !== window.location.hostname
      ) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    }, true);
  </script>

  <!-- ============================================================
       回到顶部按钮样式
       ============================================================ -->
  <style is:global>
    #back-to-top {
      position: fixed !important;
      right: 20px !important;
      bottom: 30px !important;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--card-bg, #f5f5f5);
      color: var(--text-color, #444);
      border: 1px solid var(--border-color, #e0e0e0);
      cursor: pointer;
      z-index: 99999;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
      transition: opacity 0.3s ease, transform 0.3s ease, background 0.3s ease;
      opacity: 0;
      transform: translateY(10px);
      visibility: hidden;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      -webkit-tap-highlight-color: transparent;
    }
    #back-to-top.show {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }
    #back-to-top:hover {
      background: var(--border-color, #e0e0e0);
      transform: translateY(-2px);
    }
    #back-to-top:active {
      transform: scale(0.92);
    }
    @media (max-width: 768px) {
      #back-to-top {
        right: 12px !important;
        bottom: 80px !important;
        bottom: calc(80px + env(safe-area-inset-bottom, 0px)) !important;
        width: 44px;
        height: 44px;
      }
    }
  </style>
</head>
<body class={bodyClass}>
  <slot />
  <Fragment set:html={pluginSnippets.bodyHtml} />

  <!-- ============================================================
       回到顶部按钮脚本
       ============================================================ -->
  <script is:inline>
    (function () {
      function ensureButton() {
        if (document.getElementById('back-to-top')) return;

        var btn = document.createElement('button');
        btn.id = 'back-to-top';
        btn.setAttribute('aria-label', '返回顶部');
        btn.innerHTML = '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>';
        document.body.appendChild(btn);

        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      function onScroll() {
        var b = document.getElementById('back-to-top');
        if (!b) return;
        var threshold = window.innerWidth <= 768 ? 200 : 300;
        if (window.scrollY > threshold) {
          b.classList.add('show');
        } else {
          b.classList.remove('show');
        }
      }

      ensureButton();
      window.addEventListener('scroll', onScroll, { passive: true });

      document.addEventListener('swup:contentReplaced', function () {
        ensureButton();
        onScroll();
      });
      document.addEventListener('swup:pageView', function () {
        ensureButton();
        onScroll();
      });

      var observer = new MutationObserver(function () {
        ensureButton();
      });
      observer.observe(document.body, { childList: true, subtree: false });
    })();
  </script>

  <!-- ============================================================
       全局切换函数与事件委托 (完美兼容手机端触控和 Swup 切页)
       ============================================================ -->
  <script is:inline>
    // 1. 监听系统主题变化
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
      if (localStorage.getItem('hbw-theme-pref') === 'system') {
        document.documentElement.setAttribute('data-mode', e.matches ? 'dark' : 'light');
      }
    });

    // 2. 定义全局切换函数
    window.setThemeMode = function(mode) {
      localStorage.setItem('hbw-theme-pref', mode);
      let actualMode = mode;
      if (mode === 'system') {
        actualMode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-mode', actualMode);
    };

    window.setThemeColor = function(color) {
      localStorage.setItem('hbw-theme-color', color);
      document.documentElement.setAttribute('data-color', color);
    };

    window.setThemeFont = function(size) {
      localStorage.setItem('hbw-theme-font', size);
      document.documentElement.setAttribute('data-font', size);
    };

    // 3. 增强版事件委托：完美兼容手机端触控、电脑点击和 Swup 切页
    // 增加了 capture: true，防止被 Swup 或其他插件拦截
    document.addEventListener('click', function(e) {
      // --- A. 处理面板开关 ---
      // 兼容 Index.astro 里使用的 .theme-settings-toggle
      const toggleBtn = e.target.closest('.theme-settings-toggle');
      if (toggleBtn) {
        e.preventDefault(); 
        e.stopPropagation(); // 阻止冒泡，防止其他点击事件干扰
        toggleBtn.parentElement.classList.toggle('active');
        return; 
      }

      // --- B. 点击页面空白处关闭面板 ---
      const wrapper = document.querySelector('.theme-settings-wrapper');
      if (wrapper && !e.target.closest('.theme-settings-wrapper')) {
        wrapper.classList.remove('active');
      }

      // --- C. 处理主题设置切换 (颜色/字号) ---
      const btn = e.target.closest('[data-theme-action]');
      if (!btn) return;
      
      const action = btn.getAttribute('data-theme-action');
      const value = btn.getAttribute('data-theme-value');
      
      if (action === 'mode') window.setThemeMode(value);
      if (action === 'color') window.setThemeColor(value);
      if (action === 'font') window.setThemeFont(value);
    }, true); // 👈 注意这里的 true，表示在事件捕获阶段触发，极大地提高了点击响应率
  </script>


<script is:inline>
  // 定义一个初始化相册的函数
  function initAlbumPage() {
    // 寻找相册页面的专属容器
    const albumContainer = document.getElementById('my-custom-album');
    
    // 如果当前页面没有这个容器，说明不是相册页，直接退出
    if (!albumContainer) return;

    // 【关键防重复】如果这个容器已经初始化过了，就不再执行，防止事件重复绑定
    if (albumContainer.dataset.initialized === 'true') return;
    albumContainer.dataset.initialized = 'true';

    const pagination = document.getElementById('album-pagination');
    const prevBtn = document.getElementById('album-prev');
    const nextBtn = document.getElementById('album-next');
    const pageInfo = document.getElementById('album-page-info');
    
    let currentPage = 1;
    const pageSize = 20;
    
    const apiBase = 'https://img.huw.me/api/manage/list?dir=photos&type=img';
    const imgBase = 'https://img.huw.me';

    async function loadAlbum(page) {
      albumContainer.innerHTML = '正在加载照片...';
      albumContainer.style.textAlign = 'center';
      albumContainer.style.color = '#666';
      albumContainer.style.padding = '20px';
      pagination.style.display = 'none';

      try {
        const start = (page - 1) * pageSize;
        const res = await fetch(`${apiBase}&start=${start}&count=${pageSize}`);
        
        // 打印状态码，方便调试
        console.log("API 响应状态:", res.status);

        const data = await res.json();
        const files = data.files || [];

        if (files.length === 0) {
          albumContainer.innerHTML = '相册里暂时没有照片了。';
          return;
        }

        albumContainer.innerHTML = '';
        albumContainer.style.textAlign = 'left';
        albumContainer.style.padding = '0';
        albumContainer.style.display = 'grid';
        albumContainer.style.gridTemplateColumns = 'repeat(auto-fill, minmax(150px, 1fr))';
        albumContainer.style.gap = '12px';

        files.forEach(item => {
          const imgUrl = imgBase + item.name;
          const a = document.createElement('a');
          a.href = imgUrl;
          a.target = '_blank';
          a.style.cssText = 'display: block; border-radius: 10px; overflow: hidden; aspect-ratio: 1/1; background: #eee; box-shadow: 0 2px 6px rgba(0,0,0,0.1);';
          
          const img = document.createElement('img');
          img.src = imgUrl;
          img.loading = 'lazy';
          img.style.cssText = 'width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;';
          
          img.onmouseover = () => img.style.transform = 'scale(1.05)';
          img.onmouseout = () => img.style.transform = 'scale(1)';

          a.appendChild(img);
          albumContainer.appendChild(a);
        });

        pagination.style.display = 'flex';
        pageInfo.innerText = `第 ${page} 页`;
        
        prevBtn.disabled = page === 1;
        prevBtn.style.opacity = page === 1 ? '0.5' : '1';
        
        nextBtn.disabled = files.length < pageSize;
        nextBtn.style.opacity = files.length < pageSize ? '0.5' : '1';

      } catch (error) {
        console.error('相册加载失败详细报错:', error);
        albumContainer.innerHTML = '加载失败，请按 F12 查看控制台红色报错。';
        albumContainer.style.color = 'red';
      }
    }

    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) { 
        currentPage--; 
        loadAlbum(currentPage); 
        window.scrollTo({ top: 0, behavior: 'smooth' }); 
      }
    });
    
    nextBtn.addEventListener('click', () => {
      currentPage++; 
      loadAlbum(currentPage); 
      window.scrollTo({ top: 0, behavior: 'smooth' }); 
    });

    loadAlbum(currentPage);
  }

  // 1. 页面首次加载（比如直接刷新相册页）时执行
  document.addEventListener('DOMContentLoaded', initAlbumPage);
  
  // 2. 监听 Swup 的页面替换事件（当你从首页点进相册时触发）
  document.addEventListener('swup:contentReplaced', initAlbumPage);
</script>

</body>
</html>
