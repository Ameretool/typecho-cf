---
// ============================================================
// 全局布局 Base.astro（整合版）
// ============================================================
import type { SiteOptions } from '@/lib/options';
import type { computeUrls } from '@/lib/options';
import type { UserRow } from '@/lib/context';
import { getThemeStylesheets } from '@/lib/theme';
import { getClientSnippets, type PageContext, type HookContext } from '@/lib/plugin';

// 引入我们的全局组件
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  options: SiteOptions;
  urls: ReturnType<typeof computeUrls>;
  user?: UserRow | null;
  isLoggedIn?: boolean;
  bodyClass?: string;
  pageContext?: PageContext;
  pluginCtx?: HookContext;
}

const {
  title,
  description,
  keywords,
  options,
  urls,
  user,
  isLoggedIn = false,
  bodyClass = '',
  pageContext,
  pluginCtx,
} = Astro.props;

const pageTitle = title ? `${title} - ${options.title}` : options.title;
const themeStylesheets = getThemeStylesheets(options.theme || 'typecho-theme-minimal');

// 收集插件客户端片段
const pluginSnippets = await getClientSnippets(pluginCtx ?? { activatedPlugins: new Set<string>() }, options as Record<string, any>, pageContext);
---
<!DOCTYPE html>
<html lang={options.lang === 'zh_CN' ? 'zh-CN' : 'en'}>
<head>
  <meta charset={options.charset || 'UTF-8'} />
  <meta name="renderer" content="webkit" />
  <!-- 【关键】加了 viewport-fit=cover，让 iPhone 底部手势条不遮挡右下角按钮 -->
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  {keywords && <meta name="keywords" content={keywords} />}
  {themeStylesheets.map((href) => (
    <link rel="stylesheet" href={href} />
  ))}
  <link rel="alternate" type="application/rss+xml" title={`${options.title} RSS`} href={urls.feedUrl} />
  <link rel="icon" href="/favicon.png" type="image/png">
  <slot name="head" />
  <Fragment set:html={pluginSnippets.headHtml} />

  <!-- ============================================================
       主题防闪烁脚本（必须放在 head 里，最先执行）
       ============================================================ -->
  <script is:inline>
    (function() {
      const pref = localStorage.getItem('hbw-theme-pref') || 'system';
      let mode = pref;
      if (pref === 'system') {
        mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-pref', pref);
      document.documentElement.setAttribute('data-mode', mode);
    })();
  </script>

  <!-- ============================================================
       全站外链新窗口打开脚本
       ============================================================ -->
  <script is:inline>
    document.addEventListener('click', function(e) {
      const link = e.target.closest('a');
      if (
        link &&
        link.hostname &&
        link.hostname !== window.location.hostname
      ) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    }, true);
  </script>

  <!-- ============================================================
       移动端导航汉堡菜单（仅手机端插入按钮）
       ============================================================ -->
  <script is:inline>
    (function() {
      function initNav() {
        // 只在手机端（宽度 <= 767px）才插入按钮
        if (window.innerWidth > 767) return;

        const nav = document.getElementById('nav-menu');
        if (!nav) return;
        // 避免重复添加
        if (nav.querySelector('.nav-toggle-btn')) return;

        const btn = document.createElement('button');
        btn.className = 'nav-toggle-btn';
        btn.setAttribute('aria-label', '展开导航');
        btn.innerHTML = '☰';
        nav.insertBefore(btn, nav.firstChild);

        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          nav.classList.toggle('is-open');
          btn.innerHTML = nav.classList.contains('is-open') ? '✕' : '☰';
        });

        document.addEventListener('click', function(e) {
          if (!nav.classList.contains('is-open')) return;
          if (nav.contains(e.target)) return;
          nav.classList.remove('is-open');
          btn.innerHTML = '☰';
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initNav);
      } else {
        initNav();
      }
    })();
  </script>
</head>
<body class={bodyClass}>
  <slot />
  <Fragment set:html={pluginSnippets.bodyHtml} />

  <!-- ============================================================
       全局浮动组件容器
       用一个 position: fixed 的空容器包裹，强制内部两个按钮脱离
       所有父级定位上下文，避免被主题的 relative 容器干扰
       ============================================================ -->
  <div id="global-floating-ui">
    <ThemeSwitcher />
    <BackToTop />
  </div>

  <style is:global>
    /* 容器本身不占空间、不挡点击 */
    #global-floating-ui {
      position: fixed;
      top: 0;
      left: 0;
      width: 0;
      height: 0;
      overflow: visible;
      z-index: 99999;
      pointer-events: none;
    }
    /* 容器内的按钮恢复可点击 */
    #global-floating-ui > * {
      pointer-events: auto;
    }
  </style>
</body>
</html>
