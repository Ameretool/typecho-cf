---
import type { SiteOptions } from '@/lib/options';
import type { computeUrls } from '@/lib/options';
import type { UserRow } from '@/lib/context';
import { getThemeStylesheets } from '@/lib/theme';
import { getClientSnippets, type PageContext, type HookContext } from '@/lib/plugin';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  options: SiteOptions;
  urls: ReturnType<typeof computeUrls>;
  user?: UserRow | null;
  isLoggedIn?: boolean;
  bodyClass?: string;
  pageContext?: PageContext;
  pluginCtx?: HookContext;
}

const {
  title,
  description,
  keywords,
  options,
  urls,
  user,
  isLoggedIn = false,
  bodyClass = '',
  pageContext,
  pluginCtx,
} = Astro.props;

const pageTitle = title ? `${title} - ${options.title}` : options.title;
const themeStylesheets = getThemeStylesheets(options.theme || 'typecho-theme-minimal');

// Collect client-side snippets from all activated plugins
const pluginSnippets = await getClientSnippets(pluginCtx ?? { activatedPlugins: new Set<string>() }, options as Record<string, any>, pageContext);
---
<!DOCTYPE html>
<html lang={options.lang === 'zh_CN' ? 'zh-CN' : 'en'}>
<head>
  <meta charset={options.charset || 'UTF-8'} />
  <meta name="renderer" content="webkit" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  {keywords && <meta name="keywords" content={keywords} />}
  {themeStylesheets.map((href) => (
    <link rel="stylesheet" href={href} />
  ))}
  <link rel="alternate" type="application/rss+xml" title={`${options.title} RSS`} href={urls.feedUrl} />
  <link rel="icon" href="/favicon.png" type="image/png">
  <slot name="head" />
  <Fragment set:html={pluginSnippets.headHtml} />

  <!-- ============================================================
       全站外链新窗口打开脚本
       作用：点击站外链接时，自动在新窗口打开，彻底解决慢半拍
       ============================================================ -->
  <script is:inline>
    document.addEventListener('click', function(e) {
      // 向上寻找被点击的 <a> 标签
      const link = e.target.closest('a');

      // 判断：是链接、有域名、且域名与当前站点不同（即外链）
      if (
        link &&
        link.hostname &&
        link.hostname !== window.location.hostname
      ) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    }, true); // true 代表捕获阶段拦截，点击瞬间生效
  </script>
</head>
<body class={bodyClass}>
  <slot />
  <Fragment set:html={pluginSnippets.bodyHtml} />

  <!-- ============================================================
       返回顶部按钮（全站生效）
       作用：滚动超过 300px 后出现，点击平滑滚回顶部
       配色：半透明白色 + 中性灰箭头，提前兼容未来的暗黑模式
       ============================================================ -->
  <button id="back-to-top" aria-label="返回顶部" style="display:none;">↑</button>
  <style is:global>
    #back-to-top {
      position: fixed;
      bottom: 30px;
      right: 20px;
      width: 44px;
      height: 44px;
      border-radius: 50%;

      /* 半透明背景 + 中性文字颜色，同时适配浅色/深色模式 */
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(8px);          /* 毛玻璃效果，更有质感 */
      -webkit-backdrop-filter: blur(8px);
      color: #444;                         /* 深灰色箭头，浅色下看得清 */
      border: 1px solid rgba(0, 0, 0, 0.08); /* 淡边框，让按钮有轮廓 */

      font-size: 22px;
      line-height: 42px;
      text-align: center;
      cursor: pointer;
      z-index: 9998;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);  /* 柔和阴影，深浅模式都自然 */
      transition: opacity 0.3s ease, transform 0.3s ease, background 0.3s ease;
      opacity: 0;
      transform: translateY(10px);
      padding: 0;
    }

    /* 按钮出现时 */
    #back-to-top.show {
      display: block !important;
      opacity: 1;
      transform: translateY(0);
    }

    /* 鼠标悬停时稍微亮一点 */
    #back-to-top:hover {
      background: rgba(255, 255, 255, 1);
    }

    /* ==================================================
       未来接入“暗黑模式”时，只需在 <html> 上切换类名
       比如 <html class="dark">，下面这段就会自动生效。
       ================================================== */
    html.dark #back-to-top {
      background: rgba(40, 40, 40, 0.85);  /* 深色模式下变成深灰玻璃 */
      color: #E0E0E0;                       /* 箭头变亮灰，看得清 */
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    html.dark #back-to-top:hover {
      background: rgba(60, 60, 60, 0.95);
    }
  </style>
  <script is:inline>
    (function() {
      const btn = document.getElementById('back-to-top');
      if (!btn) return;
      // 监听滚动，超过 300px 显示按钮
      window.addEventListener('scroll', function() {
        if (window.scrollY > 300) {
          btn.classList.add('show');
        } else {
          btn.classList.remove('show');
        }
      }, { passive: true });
      // 点击平滑滚回顶部
      btn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    })();
  </script>
</body>
</html>
