---
/**
 * ============================================================
 * 全局布局 Base.astro (所有页面的底层母版)
 * ============================================================
 * 包含：HTML基础结构、全局防闪烁、太阳悬浮面板、回到顶部按钮
 */
import type { SiteOptions } from '@/lib/options';
import type { computeUrls } from '@/lib/options';
import type { UserRow } from '@/lib/context';
import { getThemeStylesheets } from '@/lib/theme';
import { getClientSnippets, type PageContext, type HookContext } from '@/lib/plugin';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  options: SiteOptions;
  urls: ReturnType<typeof computeUrls>;
  user?: UserRow | null;
  isLoggedIn?: boolean;
  bodyClass?: string;
  pageContext?: PageContext;
  pluginCtx?: HookContext;
}

const {
  title,
  description,
  keywords,
  options,
  urls,
  user,
  isLoggedIn = false,
  bodyClass = '',
  pageContext,
  pluginCtx,
} = Astro.props;

const pageTitle = title ? `${title} - ${options.title}` : options.title;
const themeStylesheets = getThemeStylesheets(options.theme || 'typecho-theme-minimal');

// 收集插件客户端片段
const pluginSnippets = await getClientSnippets(pluginCtx ?? { activatedPlugins: new Set<string>() }, options as Record<string, any>, pageContext);
---
<!DOCTYPE html>
<html lang={options.lang === 'zh_CN' ? 'zh-CN' : 'en'}>
<head>
  <meta charset={options.charset || 'UTF-8'} />
  <meta name="renderer" content="webkit" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  {keywords && <meta name="keywords" content={keywords} />}
  {themeStylesheets.map((href) => (
    <link rel="stylesheet" href={href} />
  ))}
  <link rel="alternate" type="application/rss+xml" title={`${options.title} RSS`} href={urls.feedUrl} />
  <link rel="icon" href="/favicon.png" type="image/png">
  <slot name="head" />
  <Fragment set:html={pluginSnippets.headHtml} />

  <!-- ============================================================
       主题防闪烁及设置初始化脚本 (放在 Head 里防白屏闪烁)
       ============================================================ -->
  <script is:inline>
    (function() {
      const pref = localStorage.getItem('hbw-theme-pref') || 'system';
      let mode = pref;
      if (pref === 'system') {
        mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-mode', mode);
      
      const color = localStorage.getItem('hbw-theme-color') || 'blue';
      document.documentElement.setAttribute('data-color', color);

      const font = localStorage.getItem('hbw-theme-font') || 'medium';
      document.documentElement.setAttribute('data-font', font);
    })();
  </script>

  <!-- 全站外链新窗口打开脚本 -->
  <script is:inline>
    document.addEventListener('click', function(e) {
      const link = e.target.closest('a');
      if (link && link.hostname && link.hostname !== window.location.hostname) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    }, true);
  </script>

  <!-- 回到顶部按钮样式 -->
  <style is:global>
    #back-to-top {
      position: fixed !important;
      right: 20px !important;
      bottom: 30px !important;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--card-bg, #f5f5f5);
      color: var(--text-color, #444);
      border: 1px solid var(--border-color, #e0e0e0);
      cursor: pointer;
      z-index: 99999;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
      transition: opacity 0.3s ease, transform 0.3s ease, background 0.3s ease;
      opacity: 0;
      transform: translateY(10px);
      visibility: hidden;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      -webkit-tap-highlight-color: transparent;
    }
    #back-to-top.show {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }
    #back-to-top:hover {
      background: var(--border-color, #e0e0e0);
      transform: translateY(-2px);
    }
    #back-to-top:active {
      transform: scale(0.92);
    }
    @media (max-width: 768px) {
      #back-to-top {
        right: 12px !important;
        bottom: 80px !important;
        bottom: calc(80px + env(safe-area-inset-bottom, 0px)) !important;
        width: 44px;
        height: 44px;
      }
    }
  </style>
</head>
<body class={bodyClass}>
  <slot />
  <Fragment set:html={pluginSnippets.bodyHtml} />

  <!-- ============================================================
       🌟 全局悬浮主题设置面板 (写在 Body 末尾，所有页面 100% 可见)
       ============================================================ -->
  <div class="global-theme-settings" style="position: fixed; top: 80px; right: 20px; z-index: 99999;">
    <!-- 触发按钮：带有圆形背景的太阳图标 -->
    <button class="theme-settings-toggle" aria-label="主题设置" style="background: var(--card-bg); border-radius: 50%; box-shadow: 0 2px 8px rgba(0,0,0,0.1); padding: 8px; border: 1px solid var(--border-color); color: var(--text-color); cursor: pointer; display: flex; align-items: center; justify-content: center;">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </button>

    <!-- 弹出的设置面板 (默认隐藏) -->
    <div class="theme-settings-panel" style="position: absolute; top: 45px; right: 0; width: 260px; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.15); display: none; text-align: left;">
      <!-- 1. 界面模式 -->
      <div class="setting-group">
        <div class="setting-title" style="font-size: 13px; opacity: 0.7; margin-bottom: 8px;">界面模式</div>
        <div class="setting-options" style="display: flex; gap: 8px;">
          <button data-theme-action="mode" data-theme-value="light" class="opt-btn" style="flex: 1; padding: 8px 0; background: transparent; border: 1px solid var(--border-color); border-radius: 20px; cursor: pointer;">☀️</button>
          <button data-theme-action="mode" data-theme-value="dark" class="opt-btn" style="flex: 1; padding: 8px 0; background: transparent; border: 1px solid var(--border-color); border-radius: 20px; cursor: pointer;">🌙</button>
          <button data-theme-action="mode" data-theme-value="system" class="opt-btn" style="flex: 1; padding: 8px 0; background: transparent; border: 1px solid var(--border-color); border-radius: 20px; cursor: pointer;">💻</button>
        </div>
      </div>
      
      <!-- 2. 主题预设 -->
      <div class="setting-group" style="margin-top: 16px;">
        <div class="setting-title" style="font-size: 13px; opacity: 0.7; margin-bottom: 8px;">主题预设</div>
        <div class="setting-options color-options" style="display: flex; justify-content: space-between; gap: 8px;">
          <button data-theme-action="color" data-theme-value="blue" class="color-btn blue" style="width: 28px; height: 28px; border-radius: 50%; border: 1px solid #b0cde0; background: linear-gradient(135deg, #dcecf9, #ffffff); cursor: pointer;"></button>
          <button data-theme-action="color" data-theme-value="green" class="color-btn green" style="width: 28px; height: 28px; border-radius: 50%; border: none; background: #7c3aed; cursor: pointer;"></button>
          <button data-theme-action="color" data-theme-value="orange" class="color-btn orange" style="width: 28px; height: 28px; border-radius: 50%; border: none; background: #555555; cursor: pointer;"></button>
          <button data-theme-action="color" data-theme-value="purple" class="color-btn purple" style="width: 28px; height: 28px; border-radius: 50%; border: none; background: #9c4f7a; cursor: pointer;"></button>
        </div>
      </div>
      
      <!-- 3. 字号预设 -->
      <div class="setting-group" style="margin-top: 16px;">
        <div class="setting-title" style="font-size: 13px; opacity: 0.7; margin-bottom: 8px;">字号预设</div>
        <div class="setting-options" style="display: flex; gap: 8px;">
          <button data-theme-action="font" data-theme-value="small" class="opt-btn font-btn" style="flex: 1; padding: 8px 0; background: transparent; border: 1px solid var(--border-color); border-radius: 20px; cursor: pointer; font-size: 12px;">A</button>
          <button data-theme-action="font" data-theme-value="medium" class="opt-btn font-btn" style="flex: 1; padding: 8px 0; background: transparent; border: 1px solid var(--border-color); border-radius: 20px; cursor: pointer; font-size: 14px;">A</button>
          <button data-theme-action="font" data-theme-value="large" class="opt-btn font-btn" style="flex: 1; padding: 8px 0; background: transparent; border: 1px solid var(--border-color); border-radius: 20px; cursor: pointer; font-size: 16px;">A</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       回到顶部按钮脚本
       ============================================================ -->
  <script is:inline>
    (function () {
      function ensureButton() {
        if (document.getElementById('back-to-top')) return;
        var btn = document.createElement('button');
        btn.id = 'back-to-top';
        btn.setAttribute('aria-label', '返回顶部');
        btn.innerHTML = '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>';
        document.body.appendChild(btn);
        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      function onScroll() {
        var b = document.getElementById('back-to-top');
        if (!b) return;
        var threshold = window.innerWidth <= 768 ? 200 : 300;
        if (window.scrollY > threshold) {
          b.classList.add('show');
        } else {
          b.classList.remove('show');
        }
      }

      ensureButton();
      window.addEventListener('scroll', onScroll, { passive: true });

      document.addEventListener('swup:contentReplaced', function () { ensureButton(); onScroll(); });
      document.addEventListener('swup:pageView', function () { ensureButton(); onScroll(); });
      var observer = new MutationObserver(function () { ensureButton(); });
      observer.observe(document.body, { childList: true, subtree: false });
    })();
  </script>

  <!-- ============================================================
       全局主题切换与悬浮面板控制逻辑 (兼容手机端)
       ============================================================ -->
  <script is:inline>
    // 监听系统主题变化
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
      if (localStorage.getItem('hbw-theme-pref') === 'system') {
        document.documentElement.setAttribute('data-mode', e.matches ? 'dark' : 'light');
      }
    });

    // 全局切换函数
    window.setThemeMode = function(mode) {
      localStorage.setItem('hbw-theme-pref', mode);
      let actualMode = mode;
      if (mode === 'system') {
        actualMode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-mode', actualMode);
    };

    window.setThemeColor = function(color) {
      localStorage.setItem('hbw-theme-color', color);
      document.documentElement.setAttribute('data-color', color);
    };

    window.setThemeFont = function(size) {
      localStorage.setItem('hbw-theme-font', size);
      document.documentElement.setAttribute('data-font', size);
    };

    // 点击事件监听 (修复手机端无效问题)
    document.addEventListener('click', function(e) {
      // 1. 开关面板
      const toggleBtn = e.target.closest('.theme-settings-toggle');
      if (toggleBtn) {
        e.preventDefault();
        const panel = toggleBtn.nextElementSibling;
        panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
        return; 
      }

      // 2. 点击空白处关闭面板
      if (!e.target.closest('.global-theme-settings')) {
        const panel = document.querySelector('.global-theme-settings .theme-settings-panel');
        if (panel) panel.style.display = 'none';
      }

      // 3. 处理具体的切换动作
      const btn = e.target.closest('[data-theme-action]');
      if (!btn) return;
      const action = btn.getAttribute('data-theme-action');
      const value = btn.getAttribute('data-theme-value');
      if (action === 'mode') window.setThemeMode(value);
      if (action === 'color') window.setThemeColor(value);
      if (action === 'font') window.setThemeFont(value);
    });
  </script>

</body>
</html>
