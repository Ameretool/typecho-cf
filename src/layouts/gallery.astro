---
import Base from '../layouts/Base.astro';

// 如果你的 Base 布局需要参数（如 title 等），请确保这里传入，如果报错，请参考你博客原生的传参方式
---

<Base title="相册 - HB">
  <div class="container" style="margin-top: 30px; margin-bottom: 50px;">
    <h1 style="text-align: center; margin-bottom: 10px;">相册</h1>
    <p style="text-align: center; color: #666; margin-bottom: 30px;">
      这里记录了我随手拍下的风景与收藏的插画。<br>点击图片即可原地查看高清大图。
    </p>

    <!-- 相册网格区 -->
    <div class="gallery-grid" id="gallery-container">
      <!-- JS 会在这里自动生成图片 -->
    </div>
  </div>
</Base>

<style>
  /* 相册网格布局 */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 15px;
  }

  /* 单张图片卡片 */
  .gallery-card {
    border-radius: 12px;
    overflow: hidden;
    cursor: zoom-in;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    aspect-ratio: 1 / 1;
    background: #eee;
  }
  
  .gallery-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  }

  .gallery-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* === 纯 CSS 弹窗逻辑（无需 JS 拦截） === */
  .lightbox-checkbox { display: none; }
  
  .lightbox-modal {
    display: none;
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0, 0, 0, 0.9);
    z-index: 99999;
    justify-content: center;
    align-items: center;
    cursor: zoom-out;
    margin: 0;
    backdrop-filter: blur(5px);
  }

  /* 当复选框被选中时，弹窗显示 */
  .lightbox-checkbox:checked + .lightbox-modal {
    display: flex;
  }

  .lightbox-modal img {
    max-width: 95vw;
    max-height: 95vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 0 30px rgba(0,0,0,0.8);
  }

  /* 关闭按钮 */
  .lightbox-close {
    position: absolute;
    top: 20px; right: 20px;
    width: 44px; height: 44px;
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    color: #fff;
    display: flex; justify-content: center; align-items: center;
    font-size: 24px;
    pointer-events: none; /* 点击事件交给整个遮罩层 */
  }
</style>

<script>
  // 页面加载后，动态生成 12 张随机图
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('gallery-container');
    if (!container) return;

    const imageCount = 12; // 你想展示的图片数量
    let htmlContent = '';

    for (let i = 0; i < imageCount; i++) {
      // ⭐️ 关键：使用同一个随机 URL 给缩略图和大图，避免图文不符
      // t=时间戳 保证每次刷新都不一样
      const randomUrl = `https://img.huw.me/random?dir=photos&type=img&t=${Date.now()}_${i}`;
      const uniqueId = `lightbox-${i}`;

      htmlContent += `
        <div>
          <!-- 隐藏的复选框 -->
          <input type="checkbox" id="${uniqueId}" class="lightbox-checkbox">
          
          <!-- 缩略图（点击触发 checkbox） -->
          <label for="${uniqueId}" class="gallery-card">
            <img src="${randomUrl}" loading="lazy" alt="相册图片">
          </label>
          
          <!-- 大图弹窗（点击关闭） -->
          <label for="${uniqueId}" class="lightbox-modal">
            <img src="${randomUrl}" alt="高清大图">
            <div class="lightbox-close">✕</div>
          </label>
        </div>
      `;
    }
    
    container.innerHTML = htmlContent;
  });
</script>
